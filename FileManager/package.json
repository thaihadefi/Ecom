{
  "name": "file-manager",
  "version": "1.0.0",
  "main": "index.js",
  "license": "MIT",
  "scripts": {
    "start": "node -r ts-node/register index.ts",
    "dev": "nodemon --exec \"node --inspect -r ts-node/register\" index.ts",
    "typecheck": "tsc --noEmit",
    "lint:any": "bash -c '! grep -rn --include=\"*.ts\" --exclude-dir={node_modules,dist} \": any\\b\" .'"
  },
  "dependencies": {
    "@types/multer": "^2.0.0",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "mime-types": "^3.0.2",
    "multer": "^2.0.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^24.4.0",
    "nodemon": "^3.1.10",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2"
  }
}
