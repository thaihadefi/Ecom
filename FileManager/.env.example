FILE_MANAGER_SECRET=your_file_manager_secret_here
# Use at least 32 random characters (openssl rand -hex 32). FileManager refuses to start in production with a shorter secret.
# Set to "production" to enforce the secret-strength check and the CORS allowlist below. Leave unset in development.
# NODE_ENV=production
# Browser origins allowed to call FileManager, comma separated (e.g. https://thaihadefi.github.io). Unset: "*" in development, none in production.
# FILE_MANAGER_CORS_ORIGINS=
# Number of reverse proxies in front of FileManager (used for the failed-login limit). Defaults to 1 in production and 0 otherwise.
# TRUST_PROXY=
