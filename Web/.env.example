# ============================================================================
# Ecom: environment configuration
# Copy this file to .env and fill in the values below.
# ============================================================================

# ---------- Core (REQUIRED) ----------
PORT=3000
NODE_ENV=development
DATABASE=mongodb://localhost:27017/ecom_db
JWT_SECRET=your_jwt_secret_here
FILE_MANAGER_SECRET=your_file_manager_secret_here

# URL prefix of the admin panel (letters, digits, dashes). Default: admin
# ADMIN_PATH=admin

# ---------- Search ----------
# Atlas Search index name; search falls back to a regex match when the index does not exist
ATLAS_SEARCH_INDEX=default

# ---------- Media / CDN ----------
# FileManager URL (default http://localhost:4000, set by docker-compose automatically)
# FILE_MANAGER_URL=http://localhost:4000
# Set CDN_DOMAIN only when a real CDN sits in front of the media in production.
# CDN_DOMAIN=https://cdn.example.com

# ---------- Reverse Proxy ----------
# Number of reverse proxies in front of the app (used for real client IP in rate limits).
# Defaults to 1 in production and 0 otherwise. Never set above the real number of proxies.
# TRUST_PROXY=1

# ---------- Request Logger ----------
# LOG_EVERY_REQUEST=false
# SLOW_REQUEST_MS=800

# ============================================================================
# OPTIONAL INTEGRATIONS: leave blank or remove to disable
# ============================================================================

# ---------- AI Assistant (Groq) ----------
# Chat summarization, reply suggestions, sentiment analysis in admin chat.
# Leave empty to turn the AI helpers off.
GROQ_API_KEY=
# Optional: preferred chat model (default openai/gpt-oss-20b). Auto-failover if retired.
# GROQ_MODEL=openai/gpt-oss-20b

# ---------- Maps / Shipping ----------
# Reverse geocoding of map addresses for GoShip rates
OPENMAP_API_KEY=

# ============================================================================
# FEATURE FLAGS: optional modules, all on by default.
# "false" hides the module's UI, answers 404 on its pages and APIs, and stops its jobs.
# ============================================================================

# Live chat between customers and staff
# FEATURE_CHAT=true

# AI assistant in the admin chat (also needs chat on and GROQ_API_KEY above)
# FEATURE_AI=true

# Isolation Forest anomaly/fraud detection on orders
# FEATURE_ML_FRAUD=true

# "Frequently bought together" recommendations
# FEATURE_RECOMMENDATIONS=true

# Holt's linear trend stock forecasting on admin dashboard
# FEATURE_STOCK_FORECAST=true

# Storefront modules
# FEATURE_BLOG=true
# FEATURE_WISHLIST=true
# FEATURE_COMPARE=true
# FEATURE_REVIEWS=true
# FEATURE_COUPONS=true
# FEATURE_LOYALTY=true
# FEATURE_TRANSLATE=true

# ============================================================================
# PAYMENT, SHIPPING, OAUTH, THEME, LOCALE: configured in Admin > Settings and stored in the database.
# VNPay, ZaloPay, GoShip, Google/Facebook OAuth, theme colors and fonts,
# currency, locale and time zone are managed at /admin/setting/* and need no env vars.
# ============================================================================
