PORT=3000
NODE_ENV=development
DATABASE=mongodb://localhost:27017/ecom_db
JWT_SECRET=your_jwt_secret_here
GROQ_API_KEY=your_groq_api_key_here
# Optional: preferred chat model for the admin AI helpers (default openai/gpt-oss-20b). If it is retired or fails, another live model is picked automatically.
# GROQ_MODEL=openai/gpt-oss-20b
FILE_MANAGER_SECRET=your_file_manager_secret_here
OPENMAP_API_KEY=your_openmap_api_key_here
ATLAS_SEARCH_INDEX=default

# Media: images are served through this app at /media, proxied to FileManager
# (FILE_MANAGER_URL, default http://localhost:4000). No extra config for dev.
# Set CDN_DOMAIN only when a real CDN sits in front of the media in production.
# FILE_MANAGER_URL=http://localhost:4000
# CDN_DOMAIN=https://cdn.example.com

# Number of reverse proxies in front of the app (used to read the real client IP for rate limits).
# Defaults to 1 in production and 0 otherwise. Never set it above the real number of proxies.
# TRUST_PROXY=1
