          p(class="short_description")
            | !{item.description}
          a(
            href=`/product/detail/${item.slug}`
            class="common_btn"
            )
            | View Details
            i.fas.fa-long-arrow-right(aria-hidden="true")

mixin products-slider(title1, title2, productList)
  section.wow.fadeInUp(class="related_products mt_90 mb_70")
    .container
      .row
        .col-xl-6
          div(class="section_heading section_heading")
            h2
              span #{title1}
              |  #{title2}
      .row(class="mt_25 flash_sell_slider")
        each item in productList
          //- Slick controls how many cards show per view; each slide is a full
          //- column (matching blocks/flash-sale.pug). .col-xl-1-5 here would
          //- let its `max-width: 20%` collapse the card inside .slick-slide.
          .col-12
            +product-item(item)
