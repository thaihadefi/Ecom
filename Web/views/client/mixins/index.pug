mixin stars(item)
  - const ratingAvg = item.ratingAvg || item.rating || 0;
  - const fullStar = Math.floor(ratingAvg);
  - const hasHalfStar = ratingAvg - fullStar >= 0.5;

  - for(let i = 1; i <= 5; i++)
    if (i <= fullStar)
      i.fas.fa-star(aria-hidden="true")
    else if ((i == fullStar + 1) && hasHalfStar)
      i.fas.fa-star-half-alt(aria-hidden="true")
    else
      i.far.fa-star(aria-hidden="true")

mixin avatar(fullName, avatarUrl, sizeClass)
  - var size = sizeClass || "md"
  - var name = fullName || "U"
  - var parts = name.trim().split(/\s+/)
  - var initials = parts.length >= 2 ? (parts[0][0] + parts[parts.length - 1][0]).toUpperCase() : parts[0][0].toUpperCase()
  - var cdnUrl = (avatarUrl && !avatarUrl.startsWith('http')) ? getFullUrl(avatarUrl) : null
  if cdnUrl
    img.avatar-img(
      src=cdnUrl
      alt=name
      class=`avatar-${size}`
    )&attributes(attributes)
  else
    .avatar-initials.notranslate(
      class=`avatar-${size}`
      style="background: linear-gradient(135deg, #22c5ad 0%, #7367f0 100%)"
      title=name
      translate="no"
    )&attributes(attributes)
      span= initials

mixin blog-item(item)
  div(class="blog_item")
    a(
      class="blog_img"
      href=`/article/detail/${item.slug}`
      )
      img.img-fluid.w-100(
        alt=item.name
        src=`${domainCDN}${item.avatar}`
        loading="lazy"
        )
    div(class="blog_text")
      ul.top
        if (item.authorName)
          li
            span
              i.fas.fa-user(aria-hidden="true")
            | #{item.authorName}
        if (item.date)
          li
            span
              i.fas.fa-calendar-alt(aria-hidden="true")
            | #{item.date}
      a.title(href=`/article/detail/${item.slug}`)
        | #{item.name}
      ul.bottom
        li
          a(href=`/article/detail/${item.slug}`)
            | View More
            i.fas.fa-long-arrow-right(aria-hidden="true")

mixin renderCategory(items, level = 0)
  -
    var ulClass = "";
    if (level == 0) ulClass = "menu_cat_item";
    else if (level == 1) ulClass = "menu_cat_droapdown";
    else ulClass = "sub_category";

  if (items && items.length > 0)
    ul(class=ulClass)
      each item in items
        if (item.status == "active")
          li
            a(href=`/product/category/${item.slug}`)
              if (level == 0 && item.avatar)
                span.cat_icon
                  img(
                    alt=item.name
                    src=`${domainCDN}${item.avatar}`
                    loading="lazy"
                    )
              | #{item.name}
              if (item.children && item.children.length > 0)
                i.fas.fa-angle-right(aria-hidden="true")
            if (item.children && item.children.length > 0)
              +renderCategory(item.children, level+1)
      if(level == 0)
        li(class="all_category")
            a(href="/product")
              | View All
              i.fas.fa-arrow-right(aria-hidden="true")
  else if (level == 0)
    ul(class=ulClass)
      li(class="all_category")
          a(href="/product")
            | View All
            i.fas.fa-arrow-right(aria-hidden="true")

mixin page-banner(data, link)
  section(class="page_banner")
    div(class="page_banner_overlay")
      .container
        .row
          .col-12
            .wow.fadeInUp(class="page_banner_text")
              h1 #{data.name}
              ul
                li
                  a(href="/")
                    i.fas.fa-home(aria-hidden="true")
                    | Home
                li
                  a(href=link) #{data.name}

mixin product-item(item)
  -
    var disc = item.discount > 0
      ? item.discount
      : (item.priceOld && item.priceNew && item.priceOld > item.priceNew
          ? Math.round((1 - item.priceNew / item.priceOld) * 100)
          : 0);
  div(class="product_item_2 product_item")
    div(class="product_img")
      a.product_img_link(
        href=`/product/detail/${item.slug}`
        aria-label=item.name
        )
        img.img-fluid.w-100(
          alt=item.name
          src=`${domainCDN}${item.images[0]}`
          loading="lazy"
          )
      ul(class="discount_list")
        if (disc > 0)
          li.discount
            b -
            | #{disc}%
      ul(class="btn_list")
        li
          a(
            href="javascript:;"
            btn-compare-quick
            data-product-id=item._id
            title="Compare"
            aria-label="Compare"
            )
            i.fas.fa-exchange-alt(aria-hidden="true")
        li
          a(
            href="javascript:;"
            btn-wishlist-quick
            data-product-id=item._id
            title="Add to Wishlist"
            aria-label="Add to Wishlist"
            )
            i.far.fa-heart(aria-hidden="true")
        li
          a(
            href="javascript:;"
            btn-cart-quick
            data-product-id=item._id
            title="Add to Cart"
            aria-label="Add to Cart"
            )
            i.fas.fa-shopping-cart(aria-hidden="true")
    div(class="product_text")
      a.title(href=`/product/detail/${item.slug}`) #{item.name}
      p.price.d-flex.flex-wrap.align-items-baseline.gap-1
        if (item.priceNew)
          span #{formatVND(item.priceNew)}
        if (item.priceOld)
          del #{formatVND(item.priceOld)}
      p.rating
        +stars(item)
        span (#{item.ratingCount} Reviews)
      if (item.colorList && item.colorList.length > 0)
        ul.color
          each color in item.colorList
            li(style=`background:${color}`)

