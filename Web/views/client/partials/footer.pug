footer(class="footer_main pt_100")
  .container
    .row.justify-content-between
      .col-xl-3.col-lg-3.col-md-12
        div(class="footer_logo_area")
          a(
            href="/"
            class="footer_logo"
            )
            img.img-fluid.w-100(
              alt="Logo"
              src=`${settingGeneral && settingGeneral.logo ? domainCDN + settingGeneral.logo : '/images/logo.png'}`
              )
          if (settingGeneral.storeDescription)
            p= settingGeneral.storeDescription
          - const socialProfiles = SOCIAL_LINKS.filter(link => settingGeneral[link.key])
          if (socialProfiles.length)
            .footer_social_follow
              span Follow :
              each link in socialProfiles
                a.footer_social_icon(href=safeUrl(settingGeneral[link.key]) target="_blank" rel="noopener noreferrer" aria-label=link.label)
                  i(class=link.icon aria-hidden="true")
      .col-xl-2.col-lg-2.col-md-3.col-6
        div(class="footer_link")
          h2 Company
          ul
            li
              a(href="/about" target="_self") About Us
            li
              a(href="/contact" target="_self") Contact Us
      .col-xl-2.col-lg-2.col-md-3.col-6
        div(class="footer_link")
          h2 Category
          ul
            if categoryProductList && categoryProductList.length > 0
              each category in categoryProductList.slice(0, 5)
                li
                  a(href=`/product/category/${category.slug}` target="_self") #{category.name}
            else
              li
                a(href="javascript:void(0)") No categories yet
      .col-xl-2.col-lg-2.col-md-3.col-6
        div(class="footer_link")
          h2 Quick Links
          ul
            li
              a(href="/privacy-policy" target="_blank" rel="noopener noreferrer") Privacy Policy
            li
              a(href="/terms-and-conditions" target="_blank" rel="noopener noreferrer") Terms & Conditions
            li
              a(href="/return-policy" target="_blank" rel="noopener noreferrer") Return Policy
            li
              a(href="/faq" target="_blank" rel="noopener noreferrer") FAQ’s
      .col-xl-3.col-lg-3.col-md-3.col-sm-6
        div(class="footer_link footer_logo_area")
          h2 Get In Touch
          p
            | Have questions? We're here to help you every step of the way.
          if storeContact.address
            span
              b
                i.fas.fa-map-marker-alt.text-white.me-2(aria-hidden="true")
              a(href=storeContact.mapUrl target="_blank" rel="noopener noreferrer" style="color: inherit; text-decoration: none;")= storeContact.address
          if storeContact.phone
            span
              b
                i.fas.fa-phone-alt.text-white.me-2(aria-hidden="true")
              a(href=storeContact.phoneHref)= storeContact.phone
          if storeContact.email
            span
              b
                i.fas.fa-envelope.text-white.me-2(aria-hidden="true")
              a(href=`mailto:${storeContact.email}`)= storeContact.email
    .row
      .col-12
        div(class="footer_copyright mt_75")
          p
            | Copyright @
            b.notranslate(translate="no") #{settingGeneral && settingGeneral.websiteName ? settingGeneral.websiteName : "Ecom"}
            |   #{new Date().getFullYear()}. All right reserved.
          ul.payment
            li Payment by:
            each method in (paymentMethods || [])
              li(title=method.label)
                i(class=method.icon.replace(/ text-\S+/g, "") aria-hidden="true")
                span  #{method.label}
