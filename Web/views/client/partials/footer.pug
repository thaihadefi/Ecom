footer(class="footer_main pt_100")
  .container
    .row.justify-content-between
      .col-xl-3.col-lg-3.col-md-12
        div(class="footer_logo_area")
          a(
            href="/"
            class="footer_logo"
            )
            img.img-fluid.w-100(
              alt="Logo"
              src=`${settingGeneral && settingGeneral.logo ? domainCDN + settingGeneral.logo : '/images/logo.png'}`
              )
          p
            | Your one-stop destination for quality products delivered fast. Shop with confidence every day.
          .footer_social_follow
            span Follow :
            a.footer_social_icon(href="https://www.facebook.com/UIT.Fanpage" target="_blank" rel="noopener noreferrer" aria-label="Facebook")
              i.fab.fa-facebook-f(aria-hidden="true")
            a.footer_social_icon(href="https://www.youtube.com/@uitchannel" target="_blank" rel="noopener noreferrer" aria-label="YouTube")
              i.fab.fa-youtube(aria-hidden="true")
            a.footer_social_icon(href="https://www.instagram.com/uituniversity" target="_blank" rel="noopener noreferrer" aria-label="Instagram")
              i.fab.fa-instagram(aria-hidden="true")
            a.footer_social_icon(href="https://www.linkedin.com/school/university-of-information-technology" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn")
              i.fab.fa-linkedin-in(aria-hidden="true")
      .col-xl-2.col-lg-2.col-md-3.col-sm-6
        div(class="footer_link")
          h2 Company
          ul
            li
              a(href="/about" target="_self") About Us
            li
              a(href="/contact" target="_self") Contact Us
      .col-xl-2.col-lg-2.col-md-3.col-sm-6
        div(class="footer_link")
          h2 Category
          ul
            if categoryProductList && categoryProductList.length > 0
              each category in categoryProductList.slice(0, 5)
                li
                  a(href=`/product/category/${category.slug}` target="_self") #{category.name}
            else
              li
                a(href="javascript:void(0)") No categories yet
      .col-xl-2.col-lg-2.col-md-3.col-sm-6
        div(class="footer_link")
          h2 Quick Links
          ul
            li
              a(href="/privacy-policy" target="_blank" rel="noopener noreferrer") Privacy Policy
            li
              a(href="/terms-and-conditions" target="_blank" rel="noopener noreferrer") Terms & Conditions
            li
              a(href="/return-policy" target="_blank" rel="noopener noreferrer") Return Policy
            li
              a(href="/faq" target="_blank" rel="noopener noreferrer") FAQ’s
      .col-xl-3.col-lg-3.col-md-3.col-sm-6
        div(class="footer_link footer_logo_area")
          h2 Get In Touch
          p
            | Have questions? We're here to help you every step of the way.
          span
            b
              i.fas.fa-map-marker-alt.text-white.me-2(aria-hidden="true")
            a(href="https://maps.google.com/?q=Quarter+34,+Linh+Xuan+Ward,+Ho+Chi+Minh+City,+Vietnam" target="_blank" rel="noopener noreferrer" style="color: inherit; text-decoration: none;") Quarter 34, Linh Xuan Ward, Ho Chi Minh City, Vietnam
          span
            b
              i.fas.fa-phone-alt.text-white.me-2(aria-hidden="true")
            a(href="tel:02837252002") (028) 372 52002
          span
            b
              i.fas.fa-envelope.text-white.me-2(aria-hidden="true")
            a(href="mailto:info@uit.edu.vn") info@uit.edu.vn
    .row
      .col-12
        div(class="footer_copyright mt_75")
          p
            | Copyright @
            b.notranslate(translate="no") #{settingGeneral && settingGeneral.websiteName ? settingGeneral.websiteName : "Ecom"}
            |   #{new Date().getFullYear()}. All right reserved.
          ul.payment
            li Payment by:
            li(title="Cash on Delivery")
              i.fas.fa-money-bill-wave(aria-hidden="true")
              span  Cash
            li(title="ZaloPay")
              i.fas.fa-wallet(aria-hidden="true")
              span  ZaloPay
            li(title="VNPay")
              i.fas.fa-credit-card(aria-hidden="true")
              span  VNPay
