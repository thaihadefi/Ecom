include ../mixins/index.pug

nav.d-none.d-lg-block(class="main_menu_2 main_menu")
  .container
    .row
      .col-12.d-flex.flex-wrap
        div(class="main_menu_area")
          div(class="menu_category_area")
            a.d-none(
              class="menu_logo"
              href="/"
              )
              img.img-fluid.w-100.notranslate(
                alt="Logo"
                src=`${settingGeneral && settingGeneral.logo ? domainCDN + settingGeneral.logo : '/images/logo.png'}`
                translate="no"
                )
            div(class="menu_category_bar")
              p
                span
                  i.fas.fa-bars(aria-hidden="true")
                | Product Categories
              i.fas.fa-chevron-down(aria-hidden="true")
            +renderCategory(categoryProductList, 0)
          ul(class="menu_icon")
            li
              a(href="/compare" aria-label="Compare list")
                b
                  i.fas.fa-exchange-alt(aria-hidden="true")
                span(mini-compare-quantity) 0
            li
              a(href="/wishlist" aria-label="Wishlist")
                b
                  i.far.fa-heart(aria-hidden="true")
                span(mini-wishlist-quantity) 0
            li
              a(
                aria-controls="offcanvasRight"
                aria-label="Shopping cart"
                data-bs-target="#offcanvasRight"
                data-bs-toggle="offcanvas"
                )
                b
                  i.fas.fa-shopping-cart(aria-hidden="true")
                span(mini-cart-quantity) 0
            if (!accountUser)
              li
                a.user(href="/auth/login" aria-label="Login to your account")
                  b
                    i.fas.fa-user(aria-hidden="true")
                  span.menu_label Account
                ul(class="user_dropdown")
                  li
                    a(href="/auth/login")
                      <i class="fas fa-user fa-fw me-2" aria-hidden="true"></i>
                      | Login
                  li
                    a(href="/auth/register")
                      <i class="fas fa-user-plus fa-fw me-2" aria-hidden="true"></i>
                      | Register
            else
              - const _mp = (accountUser.fullName||'').trim().split(/\s+/)
              - const _mi = ((_mp[0]||'')[0]||'').toUpperCase() + ((_mp.length>1?_mp[_mp.length-1]:_mp[0]||'')[_mp.length>1?0:1]||'').toUpperCase()
              li
                a.user(href="/dashboard")
                  if accountUser.avatar && !accountUser.avatar.startsWith('http')
                    b
                      img.rounded-circle(alt=`${accountUser.fullName}` src=getFullUrl(accountUser.avatar) style="width:28px;height:28px;object-fit:cover")
                  else
                    div.avatar-initials.avatar-sm.notranslate(translate="no")= _mi
                  span.menu_label.notranslate(translate="no") #{accountUser.fullName}
                ul(class="user_dropdown")
                  li
                    a(href="/dashboard")
                      svg.size-6(aria-hidden="true"
                        stroke="currentColor"
                        stroke-width="1.5"
                        viewBox="0 0 24 24"
                        fill="none"
                        xmlns="http://www.w3.org/2000/svg"
                        )
                        path(
                          d="M3.75 12h16.5m-16.5 3.75h16.5M3.75 19.5h16.5M5.625 4.5h12.75a1.875 1.875 0 0 1 0 3.75H5.625a1.875 1.875 0 0 1 0-3.75Z"
                          stroke-linejoin="round"
                          stroke-linecap="round"
                          )
                      | Overview
                  li
                    a(href="/dashboard/profile")
                      svg.size-6(aria-hidden="true"
                        stroke="currentColor"
                        stroke-width="1.5"
                        viewBox="0 0 24 24"
                        fill="none"
                        xmlns="http://www.w3.org/2000/svg"
                        )
                        path(
                          d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.501 20.118a7.5 7.5 0 0 1 14.998 0A17.933 17.933 0 0 1 12 21.75c-2.676 0-5.216-.584-7.499-1.632Z"
                          stroke-linejoin="round"
                          stroke-linecap="round"
                          )
                      | Account
                  li
                    a(href="/dashboard/order/list")
                      svg.size-6(aria-hidden="true"
                        stroke="currentColor"
                        stroke-width="1.5"
                        viewBox="0 0 24 24"
                        fill="none"
                        xmlns="http://www.w3.org/2000/svg"
                        )
                        path(
                          d="M15.75 10.5V6a3.75 3.75 0 1 0-7.5 0v4.5m11.356-1.993 1.263 12c.07.665-.45 1.243-1.119 1.243H4.25a1.125 1.125 0 0 1-1.12-1.243l1.264-12A1.125 1.125 0 0 1 5.513 7.5h12.974c.576 0 1.059.435 1.119 1.007ZM8.625 10.5a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm7.5 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Z"
                          stroke-linejoin="round"
                          stroke-linecap="round"
                          )
                      | Orders
                  li
                    a(href="/auth/logout")
                      svg.size-6(aria-hidden="true"
                        stroke="currentColor"
                        stroke-width="1.5"
                        viewBox="0 0 24 24"
                        fill="none"
                        xmlns="http://www.w3.org/2000/svg"
                        )
                        path(
                          d="M8.25 9V5.25A2.25 2.25 0 0 1 10.5 3h6a2.25 2.25 0 0 1 2.25 2.25v13.5A2.25 2.25 0 0 1 16.5 21h-6a2.25 2.25 0 0 1-2.25-2.25V15m-3 0-3-3m0 0 3-3m-3 3H15"
                          stroke-linejoin="round"
                          stroke-linecap="round"
                          )
                      | Logout
