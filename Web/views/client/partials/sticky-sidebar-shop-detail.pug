//- Promises come from Settings > Storefront so they match the store's own policy pages; nothing here is hard-coded.
- const promiseList = productPromises || []
- const offersCashOnDelivery = (paymentMethods || []).some((method) => method.collectOnDelivery)
if (promiseList.length > 0 || offersCashOnDelivery)
  div(id="sticky_sidebar_shop")
    div(class="shop_details_sidebar")
      .row
        .col-xxl-12.col-md
          div(class="shop_details_sidebar_info")
            h2 Our promises
            ul
              each promise in promiseList
                li
                  span
                    i.fas.fa-check(aria-hidden="true")
                  if promise.href
                    a(href=promise.href)= promise.text
                  else
                    = promise.text
              if offersCashOnDelivery
                li
                  span
                    i.fas.fa-money-bill-wave(aria-hidden="true")
                  | Cash on Delivery available
