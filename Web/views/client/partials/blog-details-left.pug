div(class="blog_details_left")
  div(class="blog_details_img_1")
    img.img-fluid.w-100(
      alt=articleDetail.name
      src=`${domainCDN}${articleDetail.avatar}`
      loading="eager"
      fetchpriority="high"
      )
  ul.d-flex.flex-wrap(class="blog_details_top")
    if (articleDetail.date)
      li
        span
          i.fas.fa-calendar-alt.me-2(aria-hidden="true")
        | Published #{articleDetail.date}
    if (articleDetail.updatedDate)
      li
        span
          i.fas.fa-history.me-2(aria-hidden="true")
        | Updated #{articleDetail.updatedDate}
    if (articleDetail.authorName)
      li
        span
          i.fas.fa-user(aria-hidden="true")
        | By #{articleDetail.authorName}
    li
      span
        i.fas.fa-eye.me-2(aria-hidden="true")
      | #{articleDetail.view || 0} Views

  div(class="blog_details_desc")
    | !{safeHtml(articleDetail.description)}
  div(class="blog_details_content")
    | !{safeHtml(articleDetail.content)}
  if (articleDetail.sourceUrl)
    p(class="blog_details_source")
      | First published at
      |
      a(href=articleDetail.sourceUrl target="_blank" rel="noopener noreferrer")= articleDetail.sourceUrl.replace(/^https?:\/\/(www\.)?/, "").split("/")[0]

