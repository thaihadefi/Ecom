div(class="shop_details_slider_area")
  .row
    .col-xl-2.col-lg-3.col-md-3.order-2.order-md-1
      .row(class="details_slider_nav")
        each image in productDetail.images
          .col-12
            div(class="details_slider_nav_item")
              img.img-fluid.w-100(
                alt=productDetail.name
                src=`${domainCDN}${image}`
                loading="lazy"
                )
    .col-xl-10.col-lg-9.col-md-9.order-md-1
      .row(class="details_slider_thumb")
        each image, imageIndex in productDetail.images
          .col-12
            div(class="details_slider_thumb_item")
              a.venobox(
                href=`${domainCDN}${image}`
                data-gall=`gallery-${productDetail.slug}`
                aria-label=`View larger image of ${productDetail.name}`
                )
                //- The first photo is the page's largest paint, so it loads at once.
                img.img-fluid.w-100(
                  alt=productDetail.name
                  src=`${domainCDN}${image}`
                  loading=(imageIndex === 0 ? "eager" : "lazy")
                  fetchpriority=(imageIndex === 0 ? "high" : "auto")
                  )
