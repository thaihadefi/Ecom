div(class="checkout_payment")
  h2 Payment Method
  .form-check
    input#paymentMethodMoney.form-check-input(
      name="paymentMethod"
      type="radio"
      value="money"
      checked
      )
    label.form-check-label(for="paymentMethodMoney")
      i.fas.fa-money-bill-wave.me-2.text-success(aria-hidden="true")
      |  Cash on Delivery
  .form-check
    input#paymentMethodVNPay.form-check-input(
      name="paymentMethod"
      type="radio"
      value="vnpay"
      )
    label.form-check-label(for="paymentMethodVNPay")
      i.fas.fa-credit-card.me-2.text-primary(aria-hidden="true")
      |  Pay via VNPay
  .form-check
    input#paymentMethodZaloPay.form-check-input(
      name="paymentMethod"
      type="radio"
      value="zalopay"
      )
    label.form-check-label(for="paymentMethodZaloPay")
      i.fas.fa-wallet.me-2.text-info(aria-hidden="true")
      |  Pay via ZaloPay
  button(
    class="common_btn"
    type="submit"
    button-order
    )
    | Place Order
    i.fas.fa-long-arrow-right(aria-hidden="true")
