div(class="checkout_payment")
  h2 Payment Method
  each method, index in (paymentMethods || [])
    .form-check
      input.form-check-input(
        id=`paymentMethod-${method.id}`
        name="paymentMethod"
        type="radio"
        value=method.id
        checked=index === 0
        )
      label.form-check-label(for=`paymentMethod-${method.id}`)
        i(class=`${method.icon} me-2` aria-hidden="true")
        |  #{method.checkoutLabel}
  if (!paymentMethods || paymentMethods.length === 0)
    p.text-danger No payment method is available right now. Please contact the store.
  button(
    class="common_btn"
    type="submit"
    button-order
    )
    | Place Order
    i.fas.fa-long-arrow-right(aria-hidden="true")
