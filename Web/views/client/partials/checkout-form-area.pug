//- With no saved address to pick, the new-address form starts open and selected.
- const startWithNewAddress = !(accountUser && accountUser.addressList && accountUser.addressList.length > 0)
form(class="checkout_form_area" id="checkoutAddressForm")
  #accordionExample.accordion
    .accordion-item.border-0
      .accordion-header
        .accordion-button.p-0(
          class=startWithNewAddress ? "" : "collapsed"
          aria-controls="collapseThree"
          aria-expanded=startWithNewAddress ? "true" : "false"
          data-bs-target="#collapseThree"
          role="tabpanel"
          data-bs-toggle="collapse"
          )
          .form-check
            input#flexCheckDefault.form-check-input(
              value=""
              type="radio"
              name="userAddress"
              checked=startWithNewAddress
              )
            label.form-check-label(for="flexCheckDefault") Enter new address
      #collapseThree.accordion-collapse.collapse(class=startWithNewAddress ? "show" : "" data-bs-parent="#accordionExample")
        .accordion-body.p-0
          .row
            .col-md-6
              div(class="single_input")
                label(for="checkoutFullName") Full Name *
                input(
                  placeholder="e.g. John Doe"
                  type="text"
                  name="fullName"
                  id="checkoutFullName"
                  autocomplete="name"
                  )
            .col-md-6
              div(class="single_input")
                label(for="checkoutPhone") Phone Number *
                input(
                  placeholder="e.g. 0987654321"
                  type="tel"
                  name="phone"
                  id="checkoutPhone"
                  autocomplete="tel"
                  )
            .col-md-12.mt-4
              label(for="mapSearchInput") Select address on map *
              div(class="input-group")
                input(
                  class="form-control"
                  placeholder="Enter address to search..."
                  type="text"
                  id="mapSearchInput"
                  )
                button(
                  type="button"
                  class="btn btn-outline-secondary"
                  id="mapSearchBtn"
                  ) Search
              div(id="boxMap" style="height: 350px; margin-bottom: 25px;")
            .col-md-6
              div(class="single_input")
                label(for="longitude") Longitude *
                input(type="text" name="longitude" id="longitude")
            .col-md-6
              div(class="single_input")
                label(for="latitude") Latitude *
                input(type="text" name="latitude" id="latitude")
            .col-md-12
              div(class="single_input")
                label(for="checkoutAddress") Address *
                input(
                  placeholder="e.g. 123 ABC Street,..."
                  type="text"
                  name="address"
                  id="checkoutAddress"
                  autocomplete="street-address"
                  )
  .col-xl-12
    div(class="single_input")
      label(for="checkoutNote") Note
      textarea(
        rows="2"
        name="note"
        id="checkoutNote"
        )
