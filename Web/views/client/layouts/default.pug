  body(class="default_home")
    a.skip-to-main(href="#main-content") Skip to main content
    div#sr-live-region(aria-live="polite" aria-atomic="true" class="sr-only-live")
    include ../partials/header.pug
    include ../partials/main-menu.pug
    include ../partials/mini-cart.pug
    include ../partials/mobile-menu-area.pug

    main#main-content
      block main

    include ../partials/footer.pug

    include ../partials/chat.pug

    include ../partials/scroll-button.pug

    #modalReportReview.modal.fade(tabindex="-1" aria-labelledby="modalReportReviewLabel" aria-hidden="true")
      .modal-dialog.modal-dialog-centered.modal-sm
        .modal-content(style="border-radius: 16px; border: none; box-shadow: 0 20px 60px rgba(0,0,0,0.15);")
          .modal-body.text-center.px-4.pt-4.pb-2
            .mx-auto.mb-3(style="width:56px; height:56px; background:#fff0f0; border-radius:50%; display:flex; align-items:center; justify-content:center;")
              i.fas.fa-flag(style="font-size:22px; color:#e74c3c;")
            h6.fw-bold.mb-1(style="font-size:16px;" id="modalReportReviewLabel") Report this review?
            p.text-muted.mb-0(style="font-size:13px; line-height:1.5;") This will flag the review for admin to inspect. Only report content that is fake or inappropriate.
          .modal-footer.border-0.justify-content-center.gap-2.pb-4
            button.btn.btn-light.px-4(type="button" data-bs-dismiss="modal" style="border-radius:20px; font-size:14px;") Cancel
            button#btnConfirmReport.btn.btn-danger.px-4(type="button" style="border-radius:20px; font-size:14px;")
              i.fas.fa-flag.me-1
              | Report

    #modalPhoneConfirm.modal.fade(aria-hidden="true" tabindex="-1")
      .modal-dialog.modal-dialog-centered
        .modal-content(style="border-radius: 12px; border: none; box-shadow: 0 10px 25px rgba(0,0,0,0.1);")
          .modal-body.text-center.py-4(style="position: relative;")
            button.btn-close.position-absolute.top-0.end-0.m-3(type="button" data-bs-dismiss="modal" aria-label="Close")
            .avatar-md.rounded-circle.mx-auto.mb-3.d-flex.align-items-center.justify-content-center(style="width: 60px; height: 60px; font-size: 24px; color: #0057B7; background-color: #e6f0fa; margin: 0 auto 15px;")
              i.fas.fa-phone-alt(aria-hidden="true")
            h5.fw-semibold.mb-2(style="color: #0057B7; font-weight: 600;") Contact Hotline
            p.text-muted.small.mb-0#modalPhoneConfirmMessage(style="font-size: 14px;") Would you like to call (028) 372 52002?
          .modal-footer.border-0.justify-content-center.pt-0.pb-4
            button.btn.btn-light.px-4(type="button" data-bs-dismiss="modal" style="border-radius: 20px; font-weight: 500;") Cancel
            a.btn.btn-primary.px-4#modalPhoneConfirmCall(href="" style="border-radius: 20px; font-weight: 500; background-color: #0057B7; border-color: #0057B7;") Call Now

