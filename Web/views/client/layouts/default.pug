doctype html
html(lang="en")
  head
    script.
      (function() {
        const savedLang = localStorage.getItem("selectedLanguage") || "en";
        if (savedLang && savedLang !== "vi") {
          document.documentElement.classList.add("translation-pending");
          setTimeout(function() {
            document.documentElement.classList.remove("translation-pending");
          }, 1500);
          const observer = new MutationObserver(function(mutations) {
            if (document.documentElement.classList.contains("translated-ltr") ||
                document.documentElement.classList.contains("translated-rtl")) {
              document.documentElement.classList.remove("translation-pending");
              observer.disconnect();
            }
          });
          observer.observe(document.documentElement, { attributes: true, attributeFilter: ["class"] });
        }
      })();
    style.
      html.translation-pending body {
        visibility: hidden !important;
        opacity: 0 !important;
      }
    script.
      const domainCDN = "#{domainCDN}";
    meta(charset="UTF-8")
    meta(
      content="width=device-width, initial-scale=1.0"
      name="viewport"
      )

    title #{seo ? seo.title : pageTitle}
    meta(name="description" content=(seo ? seo.description : ""))
    meta(name="keywords" content=(seo && seo.keywords.length > 0 ? seo.keywords.join(", ") : ""))

    meta(
      name="robots",
      content=`${seo && seo.robots.index ? 'index' : 'noindex'}, ${seo && seo.robots.follow ? 'follow' : 'nofollow'}`
    )

    meta(property="og:title" content=(seo ? seo.og.title : ""))
    meta(property="og:description" content=(seo ? seo.og.description : ""))
    meta(property="og:image" content=(seo && seo.og.image ? `${domainCDN}${seo.og.image}` : ""))

    link(rel="canonical" href=canonicalUrl)

    link(rel="stylesheet", href="https://cdn.jsdelivr.net/npm/notyf@3/notyf.min.css")
