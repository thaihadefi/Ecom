section.features(class="mt_20")
  .container
    if blockData && blockData.items && blockData.items.length
      .row
        each item in blockData.items
          .col-xl-3.col-lg-3.col-sm-6.wow.fadeInUp
            div(class=`features_item ${item.color || ""}`)
              .icon(style="display:flex;align-items:center;justify-content:center;")
                if item.icon && item.icon.startsWith('fa')
                  i(class=item.icon style="font-size:2.2rem;color:#fff;")
                else if item.icon
                  img(alt=item.title src=getFullUrl(item.icon) loading="lazy" style="max-width:100%;max-height:100%;")
              .text
                h3 #{item.title}
                p #{item.description}
