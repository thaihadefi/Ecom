include ../mixins/index.pug

if blockData && blockBlogList && blockBlogList.length
  section(class="blog_area pt_95 pb_95")
    .container
      .row
        .col-xl-6.col-sm-9
          div(class="section_heading section_heading")
            h3
              | #{blockData.title.normal1}
              span #{blockData.title.highlight}
              | #{blockData.title.normal2}
        .col-xl-6.col-sm-3
          div(class="view_all_btn_area")
            a(
              href="/article"
              class="view_all_btn"
              ) #{blockData.viewAll}
      .row(class="mt_15")
        each item in blockBlogList
          .col-lg-4.col-xxl-3.col-md-6.wow.fadeInUp
            +blog-item(item)
