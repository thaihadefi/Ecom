extends ../layouts/default.pug

block main
  //
    =========================
    RESET PASSWORD START
    ==========================
  section(class="forgot_password mt_100 mb_100")
    .container
      .row.justify-content-center
        .col-xxl-5.col-lg-6.col-md-8.col-sm-10.wow.fadeInUp
          div(class="sign_in_form")
            h3 #{pageTitle}
            form(id="resetPasswordForm" data-href-success="/")
              .row
                .col-lg-12
                  div(class="single_input password-input-wrapper")
                    label(for="password") New Password
                    input(
                      placeholder="••••••••"
                      type="password"
                      name="password"
                      id="password"
                      autocomplete="new-password"
                      )
                    button(
                      type="button"
                      class="password-toggle"
                      aria-label="Show or hide password"
                      )
                      i.far.fa-eye(aria-hidden="true")
                .col-lg-12
                  div(class="single_input password-input-wrapper")
                    label(for="confirmPassword") Confirm Password
                    input(
                      placeholder="••••••••"
                      type="password"
                      name="confirmPassword"
                      id="confirmPassword"
                      autocomplete="new-password"
                      )
                    button(
                      type="button"
                      class="password-toggle"
                      aria-label="Show or hide password"
                      )
                      i.far.fa-eye(aria-hidden="true")
                .col-xl-12(class="mt_15")
                  button(
                    class="common_btn" 
                    type="submit"
                    )
                    | Change Password
                    i.fas.fa-long-arrow-right(aria-hidden="true")
  //
    =========================
    RESET PASSWORD END
    ==========================