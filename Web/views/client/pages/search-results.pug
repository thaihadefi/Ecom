extends ../layouts/default.pug
include ../mixins/index.pug

block main
  section(class="search_results mt_100 mb_100")
    .container
      .row
        .col-12
          h2.mb-4
            | Search results for:
            strong.ms-2 "#{keyword}"

      if (productList.length > 0)
        .row.mb-5
          .col-12
            h4.mb-3 Products (#{pagination.totalRecord})
          each item in productList
            .col-xxl-3.col-6.col-md-4.col-lg-3.wow.fadeInUp
              +product-item(item)
          .col-12
            include ../partials/pagination-area.pug

      else if (keyword)
        .row.mb-5
          .col-12
            p.text-muted No products found.

      if (articleList.length > 0)
        .row
          .col-12
            h4.mb-3 Articles
          each item in articleList
            .col-xl-4.col-md-6.wow.fadeInUp
              +blog-item(item)

      if (productList.length === 0 && articleList.length === 0)
        .row
          .col-12
            .text-center.py-5
              i.fas.fa-search.fa-3x.text-muted.mb-3(aria-hidden="true")
              h5.text-muted No results found for "#{keyword}"
              a.btn.btn-primary.mt-3(href="/") Back to Home
