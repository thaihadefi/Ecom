extends ../layouts/default.pug
include ../mixins/index.pug

block main
  +page-banner({ name: pageTitle }, "/return-policy")

  section.mt_80.mb_100
    .container
      .row.justify-content-center
        .col-lg-8
          div(style="background:#eff6ff;border-left:4px solid #0057B7;border-radius:4px;padding:16px 20px;margin-bottom:32px;")
            p(style="margin:0;color:#1e40af;font-weight:600;") We accept returns within 30 days of delivery for unused, unwashed items in original condition.

          h4(style="color:#0057B7;font-weight:600;margin-bottom:12px;") Eligible Items
          p(style="color:#374151;line-height:1.8;") Items must be unworn, unwashed, and in their original packaging with all tags attached. Sale items and customized products are not eligible for return.

          h4(style="color:#0057B7;font-weight:600;margin:28px 0 12px;") How to Return
          ol(style="color:#374151;line-height:2;padding-left:20px;")
            li Contact us at info@uit.edu.vn with your order number and reason for return
            li We will send you a return shipping label within 1–2 business days
            li Pack the item securely and drop it off at the nearest courier location
            li Once received and inspected, your refund will be processed within 5–7 business days

          h4(style="color:#0057B7;font-weight:600;margin:28px 0 12px;") Refund Method
          p(style="color:#374151;line-height:1.8;") Refunds are issued to the original payment method. Shipping costs are non-refundable unless the return is due to our error.

          h4(style="color:#0057B7;font-weight:600;margin:28px 0 12px;") Exchanges
          p(style="color:#374151;line-height:1.8;") We offer free size exchanges on all regular-priced items. Contact us within 30 days of delivery to initiate an exchange.
