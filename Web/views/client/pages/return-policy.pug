extends ../layouts/default.pug
include ../mixins/index.pug

block main
  +page-banner({ name: pageTitle }, "/return-policy")

  section.mt_80.mb_100
    .container
      .row.justify-content-center
        .col-lg-8
          div(style="background:var(--gold-soft);border-left:3px solid var(--gold);border-radius:0;padding:16px 20px;margin-bottom:32px;")
            p(style="margin:0;color:var(--ink);font-weight:600;") We accept returns within 30 days of delivery for unused items in their original condition.

          h2(style="color:var(--ink);font-weight:600;font-size:19px;margin-bottom:12px;") Eligible Items
          p(style="color:var(--ink);line-height:1.8;") Items must be unused and in their original condition and packaging, with any tags attached. Customized or personalized products cannot be returned unless they arrive damaged or faulty.

          h2(style="color:var(--ink);font-weight:600;font-size:19px;margin:28px 0 12px;") How to Return
          ol(style="color:var(--ink);line-height:2;padding-left:20px;")
            li Contact us #{storeContact.email ? `at ${storeContact.email}` : 'through the contact page'} with your order number and reason for return
            li We will send you a return shipping label within 1–2 business days
            li Pack the item securely and drop it off at the nearest courier location
            li Once received and inspected, your refund will be processed within 5–7 business days

          h2(style="color:var(--ink);font-weight:600;font-size:19px;margin:28px 0 12px;") Refund Method
          p(style="color:var(--ink);line-height:1.8;") Refunds are issued to the original payment method. Shipping costs are non-refundable unless the return is due to our error.

          h2(style="color:var(--ink);font-weight:600;font-size:19px;margin:28px 0 12px;") Exchanges & Warranty
          p(style="color:var(--ink);line-height:1.8;") Items that arrive faulty or damaged in transit are exchanged free of charge within 30 days of delivery. Any manufacturer warranty that comes with a product also applies.
