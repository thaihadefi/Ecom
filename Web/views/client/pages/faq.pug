extends ../layouts/default.pug
include ../mixins/index.pug

block main
  +page-banner({ name: pageTitle }, "/faq")

  section.mt_80.mb_100
    .container
      .row.justify-content-center
        .col-lg-8
          //- Default answers, shown until the store writes its own in Settings > Page Content. They only state
          //- what the storefront does, and read payment methods from the store's settings.
          - const methodNames = (paymentMethods || []).map((method) => method.label)
          - const faqItems = [["What do you sell?", "catalog"], ["How much is shipping, and how do I follow my order?", "shipping"], ["How can I pay?", "payment"], ["Can I change or cancel my order?", "change"], ["Can I return or exchange an item?", "returns"]]
          .accordion#faqAccordion
            each faqItem, faqIndex in faqItems
              .accordion-item.faq-item
                h2.accordion-header
                  button.accordion-button(
                    class=faqIndex === 0 ? "" : "collapsed"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target=`#faq${faqIndex + 1}`
                    aria-expanded=faqIndex === 0 ? "true" : "false"
                    aria-controls=`faq${faqIndex + 1}`
                    )= faqItem[0]
                .accordion-collapse.collapse(id=`faq${faqIndex + 1}` class=faqIndex === 0 ? "show" : "" data-bs-parent="#faqAccordion")
                  .accordion-body.faq-body
                    case faqItem[1]
                      when "catalog"
                        | Everything we sell is in
                        |
                        a(href="/product") the catalog
                        | , grouped by category. Each product page lists its details, options, price and stock.
                      when "shipping"
                        | The shipping cost is worked out at checkout from your delivery address, before you pay. Once the order is placed, its status is in your account.
                      when "payment"
                        if methodNames.length
                          | At checkout you can pay with #{methodNames.join(", ")}.
                        else
                          | The payment options are shown at checkout.
                      when "change"
                        | Contact us as soon as you can, before the order ships, and we will do our best to change or cancel it. Our details are on the
                        |
                        a(href="/contact") Contact page
                        | .
                      when "returns"
                        | Our
                        |
                        a(href="/return-policy") Return Policy
                        |  explains which items can be returned or exchanged, and how.
