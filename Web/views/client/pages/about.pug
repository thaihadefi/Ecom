extends ../layouts/default.pug
include ../mixins/index.pug

//- Default About page, shown until the store writes its own in Settings > Page Content.
//- It only states what the storefront itself does, so it stays true for every client store.
block main
  +page-banner({ name: pageTitle }, "/about")

  section.about_default.mt_80.mb_100
    .container
      .row.justify-content-center
        .col-lg-8
          h2 Who we are
          if (settingGeneral && settingGeneral.storeDescription)
            p= settingGeneral.storeDescription
          p
            | We keep buying simple: clear product details, prices you see before you pay, and real people to answer your questions.
          p
            | Before you order, read our
            |
            a(href="/return-policy") Return Policy
            | . For anything else, our contact details are at the bottom of every page.

          .row.mt_40
            .col-md-4.mb-4
              .about_default_card
                i.fas.fa-tags(aria-hidden="true")
                h3 Clear product details
                p Material, sizes, colours and customer reviews on every product page.
            .col-md-4.mb-4
              .about_default_card
                i.fas.fa-truck(aria-hidden="true")
                h3 Shipping you can follow
                p Shipping cost shown at checkout, and your order status in your account.
            .col-md-4.mb-4
              .about_default_card
                i.fas.fa-comments(aria-hidden="true")
                h3 Help from our team
                if (FEATURES.CHAT)
                  p Chat with us from any page, or call and email us.
                else
                  p Call or email us using the details at the bottom of the page.
