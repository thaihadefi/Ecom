extends ../layouts/default.pug
include ../mixins/index.pug

block main
  +page-banner({ name: pageTitle }, "/about")

  section.mt_80.mb_100
    .container
      .row.justify-content-center
        .col-lg-8
          h2(style="color:#1C1917;font-weight:700;margin-bottom:16px;") Who We Are
          p(style="color:#374151;font-size:15px;line-height:1.8;")
            | We are a modern, multi-category e-commerce platform dedicated to bringing high-quality products and an exceptional shopping experience to customers everywhere. Our curated catalog features reliable products across diverse categories, backed by transparent pricing and dependable customer service.
          p(style="color:#374151;font-size:15px;line-height:1.8;margin-top:16px;")
            | We believe modern online shopping should be seamless, fast, and secure. From instant real-time customer support and transparent order tracking to flexible payment and delivery options, our mission is to deliver excellence with every single order.

          div(style="background:#F3ECDD;border-left:3px solid #A16207;border-radius:0;padding:20px 24px;margin:32px 0;")
            h3(style="color:#1C1917;font-weight:600;font-size:18px;margin-bottom:8px;") Our Mission
            p(style="color:#374151;font-size:15px;line-height:1.8;margin:0;")
              | To provide a reliable, customer-centric retail ecosystem that empowers shoppers with genuine quality, fast fulfillment, and intelligent AI-powered support.

          .row.mt_40
            .col-md-4.text-center.mb-4
              div(style="background:#F4F2EF;border-radius:0;padding:28px 16px;")
                i.fas.fa-shield-alt(aria-hidden="true" style="font-size:36px;color:#A16207;margin-bottom:12px;")
                h3(style="font-weight:600;font-size:16px;") 100% Genuine Quality
                p(style="color:#6b7280;font-size:14px;margin:0;") Verified authentic products sourced from trusted manufacturers
            .col-md-4.text-center.mb-4
              div(style="background:#F4F2EF;border-radius:0;padding:28px 16px;")
                i.fas.fa-shipping-fast(aria-hidden="true" style="font-size:36px;color:#A16207;margin-bottom:12px;")
                h3(style="font-weight:600;font-size:16px;") Fast & Safe Delivery
                p(style="color:#6b7280;font-size:14px;margin:0;") Real-time shipping rate calculation and end-to-end tracking
            .col-md-4.text-center.mb-4
              div(style="background:#F4F2EF;border-radius:0;padding:28px 16px;")
                i.fas.fa-headset(aria-hidden="true" style="font-size:36px;color:#A16207;margin-bottom:12px;")
                h3(style="font-weight:600;font-size:16px;") 24/7 Live Support
                p(style="color:#6b7280;font-size:14px;margin:0;") Instant messaging and AI-assisted customer care anytime
