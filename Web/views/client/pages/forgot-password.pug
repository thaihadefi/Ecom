extends ../layouts/default.pug

block main
  section(class="forgot_password mt_100 mb_100")
    .container
      .row.justify-content-center
        .col-xxl-5.col-lg-6.col-md-8.col-sm-10.wow.fadeInUp
          div(class="sign_in_form")
            h1 #{pageTitle}
            form(id="forgotPasswordForm")
              .row
                .col-xl-12
                  div(class="single_input")
                    label(for="email") Email *
                    input(
                      placeholder="e.g. johndoe@gmail.com"
                      type="email"
                      name="email"
                      id="email"
                      autocomplete="email"
                      )
                .col-xl-12(class="mt_15")
                  button(
                    class="common_btn"
                    type="submit"
                    )
                    | Reset Password
                    i.fas.fa-long-arrow-right(aria-hidden="true")
