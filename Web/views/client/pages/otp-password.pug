extends ../layouts/default.pug

block main
  section(class="forgot_password mt_100 mb_100")
    .container
      .row.justify-content-center
        .col-xxl-5.col-lg-6.col-md-8.col-sm-10.wow.fadeInUp
          div(class="sign_in_form")
            h3 #{pageTitle}
            form(id="otpPasswordForm")
              .row
                .col-xl-12
                  div(class="single_input")
                    label(for="email") Email
                    input(
                      type="email"
                      name="email"
                      id="email"
                      value=email
                      readonly
                      )
                .col-xl-12
                  div(class="single_input")
                    label(for="otp") OTP Code
                    input(
                      placeholder="e.g. 123456"
                      type="text"
                      name="otp"
                      id="otp"
                      inputmode="numeric"
                      autocomplete="one-time-code"
                      maxlength="6"
                      pattern="[0-9]{6}"
                      )
                .col-xl-12(class="mt_15")
                  button(
                    class="common_btn"
                    type="submit"
                    )
                    | Verify
                    i.fas.fa-long-arrow-right(aria-hidden="true")
