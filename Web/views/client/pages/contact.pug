extends ../layouts/default.pug
include ../mixins/index.pug

block main
  +page-banner({ name: pageTitle }, "/contact")

  section.mt_80.mb_100
    .container
      .row.justify-content-center
        .col-lg-5.mb-5.mb-lg-0
          h2(class="contact-section-title") Get In Touch
          //- Every row comes from Settings > General and is hidden when that field is empty.
          if storeContact.address
            .contact_info_item
              i.fas.fa-map-marker-alt(aria-hidden="true")
              div
                h3 Address
                a(href=storeContact.mapUrl target="_blank" rel="noopener noreferrer")= storeContact.address
          if storeContact.phone
            .contact_info_item
              i.fas.fa-phone-alt(aria-hidden="true")
              div
                h3 Hotline
                a(href=storeContact.phoneHref)= storeContact.phone
          if storeContact.email
            .contact_info_item
              i.fas.fa-envelope(aria-hidden="true")
              div
                h3 Email
                a(href=`mailto:${storeContact.email}`)= storeContact.email
          if settingGeneral && settingGeneral.openingHours
            .contact_info_item
              i.fas.fa-clock(aria-hidden="true")
              div
                h3 Opening hours
                p= settingGeneral.openingHours

        .col-lg-6.offset-lg-1
          h2(class="contact-section-title") Send A Message
          form#contact-form
            .row
              .col-md-6
                div(class="single_input")
                  label(for="name") Full Name *
                  input(
                    placeholder="e.g. John Doe"
                    type="text"
                    name="name"
                    id="name"
                    autocomplete="name"
                    required
                    )
              .col-md-6
                div(class="single_input")
                  label(for="email") Email *
                  input(
                    placeholder="e.g. john@email.com"
                    type="email"
                    name="email"
                    id="email"
                    autocomplete="email"
                    required
                    )
              .col-md-12
                div(class="single_input")
                  label(for="subject") Subject
                  input(
                    placeholder="e.g. Product inquiry"
                    type="text"
                    name="subject"
                    id="subject"
                    autocomplete="off"
                    )
              .col-md-12
                div(class="single_input")
                  label(for="message") Message *
                  textarea(
                    placeholder="Your message here..."
                    rows="5"
                    name="message"
                    id="message"
                    required
                    )
              .col-md-12
                button.common_btn(type="submit")
                  | Send Message
                  i.fas.fa-long-arrow-right(aria-hidden="true")
