extends ../layouts/default.pug
include ../mixins/index.pug

block main
  if (permissions.includes("article-list"))
    .row
      .col-12
        .card
          .card-header
            .row.align-items-center
              .col
                h4.card-title #{pageTitle}
              // end col
              .col-auto
                button.btn.btn-danger.me-1(
                  button-soft-delete-many
                  data-api=`/${pathAdmin}/article/delete-many`
                  style="display:none"
                )
                  i.fa-solid.fa-trash.me-1
                  | Move to Trash
                if (permissions.includes("article-create"))
                  a.btn.btn-primary(
                    href=`/${pathAdmin}/article/create`
                    )
                    i.fa-solid.fa-plus.me-1
                    | Create Article
                    // end col
              // end col
            // end row
          // end card-header
          .card-body.pt-0
            .row
              .col-lg-6
                +form-search()
            .table-responsive
              table.table.table-striped.mb-0
                thead.table-light
                  tr
                    th(scope="col")
                      input.form-check-input.checkbox-all(type="checkbox")
                    th(scope="col") No.
                    th(scope="col") Avatar
                    th(scope="col") Article Title
                    th(scope="col") Status
                    th(scope="col") Views
                    th.text-end(scope="col") Action
                tbody
                  if !recordList || !recordList.length
                    +empty-state()
                  else
                    each item, index in recordList
                      tr
                        td
                          input.form-check-input.checkbox-input(type="checkbox" value=item.id)
                        td #{pagination.skip + index + 1}
                        td
                          if(item.avatar)
                            img(
                              src=`${domainCDN}${item.avatar}`
                              class="rounded thumb-md me-1 d-inline"
                              alt=""
                              loading="lazy"
                            )
                        td #{item.name}
                        td
                          if (item.status == "draft")
                            span(class="badge bg-dark") Draft
                          else if (item.status == "published")
                            span(class="badge bg-success") Published
                          else if (item.status == "archived")
                            span(class="badge bg-danger") Archived
                        td #{item.view}
                        td.text-end
                          if (permissions.includes("article-edit"))
                            a.tbl-action(
                              href=`/${pathAdmin}/article/edit/${item.id}`
                              title="Edit"
                              aria-label="Edit"
                            )
                              i.las.la-pen.text-secondary.fs-20
                            a.tbl-action(
                              href=`/${pathAdmin}/article/edit-seo/${item.id}`
                              title="Edit SEO"
                              aria-label="Edit SEO"
                            )
                              i.las.la-search.text-secondary.fs-20
                          if (permissions.includes("article-delete"))
                            a.tbl-action.danger(
                              href="javascript:;"
                              button-api
                              data-method="PATCH"
                              data-api=`/${pathAdmin}/article/delete/${item.id}`
                              title="Move to trash"
                              aria-label="Move to trash"
                            )
                              i.las.la-trash-alt.text-secondary.fs-20
            +pagination()
      // end col
