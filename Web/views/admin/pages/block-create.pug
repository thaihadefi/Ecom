extends ../layouts/default.pug

block main
  .card
    .card-header
      .row.align-items-center
        .col
          h4.card-title #{pageTitle}
    .card-body.pt-0
      form(id="blockCreateForm")
        .row
          .col-md-12
            .mb-3
              label.form-label(for="name") Block Name *
              input.form-control(id="name" type="text" name="name")
          .col-md-6
            .mb-3
              label.form-label(for="fileName") Interface File *
              select.form-select(name="fileName" id="fileName")
                option(value="") - Select Interface File -
                each file in fileList
                  option(value=file) #{file}
          .col-md-6
            .mb-3
              label.form-label(for="status") Status
              select.form-select(id="status" name="status")
                option(value="active") Active
                option(value="inactive") Inactive
          .col-md-12
            .mb-3
              label.form-label(for="data") Block Data (JSON format)
              div(json-editor style="height: 500px")
        button.btn.btn-primary(type="submit") Create New
        a.btn.btn-danger.ms-1(href=`/${pathAdmin}/block/list`) Cancel
