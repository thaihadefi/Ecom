extends ../layouts/default.pug
include ../mixins/index.pug

block main
  .row
    .col-12
      .card
        .card-header
          .row.align-items-center
            .col
              h4.card-title #{pageTitle}
            // end col
            .col-auto
              a.btn.btn-outline-danger.me-1(href=`/${pathAdmin}/product/attribute/trash`)
                i.fa-solid.fa-trash.me-1
                | Trash
              a.btn.btn-primary(
                href=`/${pathAdmin}/product/attribute/create`
                )
                i.fa-solid.fa-plus.me-1
                | Create Attribute
                // end col
            // end col
          // end row
        // end card-header
        .card-body.pt-0
          .row
            .col-lg-6
              +form-search()
          .table-responsive
            table.table.table-striped.mb-0
              thead.table-light
                tr
                  th(scope="col") No.
                  th(scope="col") Attribute Name
                  th(scope="col") Display Type
                  th(scope="col") Options List
                  th.text-end(scope="col") Action
              tbody
                if !recordList || !recordList.length
                  +empty-state()
                else
                  each item, index in recordList
                    tr
                      td #{pagination.skip + index + 1}
                      td #{item.name}
                      td #{item.type}
                      td
                        each option in item.options
                          span(class="badge bg-info me-1 mb-1") #{option.label}
                      td.text-end
                        a.tbl-action(
                          href=`/${pathAdmin}/product/attribute/edit/${item.id}`
                          title="Edit"
                          aria-label="Edit"
                        )
                          i.las.la-pen.text-secondary.fs-20
                        a.tbl-action.danger(
                          href="javascript:;"
                          button-api
                          data-method="PATCH"
                          data-api=`/${pathAdmin}/product/attribute/delete/${item.id}`
                          title="Move to trash"
                          aria-label="Move to trash"
                        )
                          i.las.la-trash-alt.text-secondary.fs-20
          +pagination()
    // end col
