extends ../layouts/default.pug

block main
  .row
    .col-12
      h4.card-title.mb-2 #{pageTitle}
      include ../partials/chat-box-left.pug
      .chat-box-right(chat-room-id=chatRoomDetail.id data-user-id=chatRoomDetail.userId)
        .p-3.d-flex.justify-content-between.card-bg.rounded
          a.d-flex.align-self-center(href="#")
            .flex-shrink-0
              - const _hp = (infoUser.fullName || '').trim().split(/\s+/)
              - const _hi = ((_hp[0]||'')[0]||'').toUpperCase() + ((_hp.length>1?_hp[_hp.length-1]:_hp[0]||'')[_hp.length>1?0:1]||'').toUpperCase()
              if infoUser.avatar && !infoUser.avatar.startsWith('http')
                img.rounded-circle.thumb-lg(
                  alt=infoUser.fullName
                  src=`${domainCDN}/${infoUser.avatar}`
                  onerror=`this.style.display='none';this.nextElementSibling.style.display='flex'`
                )
                span.avatar-initials.thumb-lg.rounded-circle(style="display:none") #{_hi}
              else
                span.avatar-initials.thumb-lg.rounded-circle #{_hi}
            .flex-grow-1.ms-2.align-self-center
              div
                h6.my-0.fw-medium.text-dark.fs-14 #{infoUser.fullName}
                .d-flex.align-items-center.gap-1.mt-1
                  span#admin-chat-online-dot.admin-chat-online-dot
                  span#admin-chat-status-text.admin-chat-status-text Online
          .d-none.d-sm-inline-block.align-self-center
            a.me-2.text-muted(
              data-bs-custom-class="tooltip-primary"
              data-bs-title="Customer Emotion"
              data-bs-placement="top"
              data-bs-toggle="tooltip"
              href="javascript:;"
              id="button-ai-customer-emotions"
              )
              i.iconoir-people-tag.fs-22
            a.me-2.text-muted(
              data-bs-custom-class="tooltip-primary"
              data-bs-title="Chat Summary"
              data-bs-placement="top"
              data-bs-toggle="tooltip"
              href="javascript:;"
              id="button-ai-chat-summary"
              )
              i.iconoir-safe-arrow-left.fs-22
            a.me-2.text-muted(
              data-bs-custom-class="tooltip-primary"
              data-bs-title="View Rating"
              data-bs-placement="top"
              data-bs-toggle="tooltip"
              href=`/${pathAdmin}/chat/rate/${chatRoomDetail.id}`
              )
              i.iconoir-star.fs-22
            if (chatRoomDetail.status === 'open')
              a.me-2.text-muted(
                data-bs-custom-class="tooltip-primary"
                data-bs-title="Open. Lock now!"
                data-bs-placement="top"
                data-bs-toggle="tooltip"
                href="javascript:;"
                button-lock="locked"
                )
                i.iconoir-lock.fs-22
            if (chatRoomDetail.status === 'locked')
              a.me-2.text-muted(
                data-bs-custom-class="tooltip-primary"
                data-bs-title="Locked. Open now!"
                data-bs-placement="top"
                data-bs-toggle="tooltip"
                href="javascript:;"
                button-lock="open"
                )
                i.iconoir-lock-slash.fs-22
            a.me-2.text-muted(
              data-bs-custom-class="tooltip-primary"
              data-bs-title="Delete Chat"
              data-bs-placement="top"
              data-bs-toggle="tooltip"
              href="javascript:;"
              button-delete-room
              )
              i.iconoir-trash.fs-22
        .chat-body
          .chat-detail
        #chat-ai-suggest-reply.chat-ai-suggest-reply.d-none
          .inner-content
          .inner-close ✕
        #chat-preview.chat-preview.d-none
        .chat-footer(form-chat)
          .d-flex.align-items-center
            div(style="flex: 1;")
              input.form-control(
                placeholder="Message content..."
                type="text"
                input-content
                )
            div
              .d-none.d-sm-inline-block.chat-features
                input#chat-file(type="file" multiple hidden)
                a(
                  data-bs-custom-class="tooltip-primary"
                  data-bs-title="Edit Response"
                  data-bs-placement="top"
                  data-bs-toggle="tooltip"
                  href="javascript:;"
                  id="button-ai-edit-reply"
                  )
                  i.iconoir-page-edit.fs-22
                a(
                  data-bs-custom-class="tooltip-primary"
                  data-bs-title="Suggest Response"
                  data-bs-placement="top"
                  data-bs-toggle="tooltip"
                  href="javascript:;"
                  id="button-ai-suggest-reply"
                  )
                  i.iconoir-suggestion.fs-22
                a(href="javascript:;" id="chat-attach")
                  i.iconoir-attachment
                a.text-primary(href="javascript:;" button-send)
                  i.iconoir-send-solid

  #admin-confirm-modal.admin-confirm-overlay.d-none(role="alertdialog" aria-modal="true")
    .admin-confirm-box
      .admin-confirm-icon
        i.iconoir-warning-triangle
      p.admin-confirm-title Delete?
      p.admin-confirm-msg This action cannot be undone.
      .admin-confirm-actions
        button#admin-confirm-cancel.admin-confirm-btn-cancel Cancel
        button#admin-confirm-ok.admin-confirm-btn-ok Delete
