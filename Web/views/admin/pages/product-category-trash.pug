extends ../layouts/default.pug
include ../mixins/index.pug

block main
  .row
    .col-12
      .card
        .card-header
          +trash-header(`/${pathAdmin}/product/category`)
        .card-body.pt-0
          +trash-buttons(`/${pathAdmin}/api/product-categories`)
          .table-responsive
            table.table.table-striped.mb-0
              thead.table-light
                tr
                  th(scope="col")
                    input.checkbox-all(type="checkbox" aria-label="Select all rows")
                  th(scope="col") No.
                  th(scope="col") Category Name
                  th(scope="col") Parent Category
                  th(scope="col") Status
                  th(scope="col") Deleted At
                  th.text-end(scope="col") Action
              tbody
                if !recordList || !recordList.length
                  +empty-state("Trash is empty")
                else
                  each item, index in recordList
                    tr
                      td
                        input.checkbox-input(type="checkbox" aria-label="Select this row" value=item.id)
                      td #{index + 1}
                      td #{item.name}
                      td #{item.parentName}
                      td
                        if (item.status == "active")
                          span(class="badge bg-success") Active
                        else if (item.status == "inactive")
                          span(class="badge bg-danger") Inactive
                      td
                        small #{formatDateTime(item.deletedAt)}
                      td.text-end
                        +trash-action-buttons(
                          `/${pathAdmin}/api/product-categories/${item.id}/restore`,
                          `/${pathAdmin}/api/product-categories/${item.id}?permanent=true`
                        )
