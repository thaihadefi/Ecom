extends ../layouts/default.pug
include ../mixins/index.pug

block main
  .card
    .card-header
      .row.align-items-center
        .col
          h4.card-title #{pageTitle}
    .card-body.pt-0
      form(id="productCreateAttributeForm")
        .row
          .col-md-6.col-lg-6
            .mb-3
              label.form-label(for="name") Attribute Name *
              input.form-control(id="name" type="text" name="name")
          .col-md-6.col-lg-6
            .mb-3
              label.form-label(for="type") Display Type
              select.form-select(id="type" name="type")
                option(value="") -- Select Display Type --
                option(value="text") text
                option(value="select") select
                option(value="color") color
          .col-md-12.col-lg-12
            .mb-3
              label.form-label Options List
              +box-option("options")
        button.btn.btn-primary(type="submit") Create New
        a.btn.btn-danger.ms-1(href=`/${pathAdmin}/product/attribute`) Cancel
