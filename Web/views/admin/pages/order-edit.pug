extends ../layouts/default.pug

block main
  .card
    .card-header
      .row.align-items-center
        .col
          h4.card-title #{pageTitle} - #{orderDetail.code}
    .card-body.pt-0
      form(id="orderEditForm")
        input(type="hidden" name="id" value=orderDetail.id)
        h5.mt-3 Customer Information
        .row
          .col-md-6
            .mb-3
              label.form-label(for="order-full-name") Full Name
              input.form-control(id="order-full-name" disabled value=orderDetail.fullName)
          .col-md-6
            .mb-3
              label.form-label(for="order-phone-number") Phone Number
              input.form-control(id="order-phone-number" disabled value=orderDetail.phone)
          .col-md-12
            .mb-3
              label.form-label(for="order-address") Address
              textarea.form-control(id="order-address" rows="2" disabled)= orderDetail.address
        h5.mt-4 Products in Order
        .table-responsive
          table.table.table-bordered
            thead.table-light
              tr
                th(scope="col") Products
                th(scope="col") Attributes
                th(scope="col") Qty
                th(scope="col") Price
                th(scope="col") Total
            tbody
              each p in orderDetail.items
                tr
                  td
                    .d-flex.align-items-center
                      img(src=`${domainCDN}${p.image}` width="50" class="me-2 rounded" alt="" loading="lazy")
                      span #{p.name}
                  td
                    if p.variant && p.variant.length > 0
                      each v in p.variant
                        div.small.text-muted #{v}
                    else
                      span.text-muted -
                  td #{p.quantity}
                  td.text-nowrap #{formatPrice((p.price || 0))}
                  td.text-danger.text-nowrap
                    b #{formatPrice(((p.price || 0) * p.quantity))}
        h5.mt-4 Payment & Shipping
        .row
          .col-md-4
            .mb-3
              label.form-label(for="order-payment-method") Payment Method
              input.form-control(id="order-payment-method" 
                disabled
                value=paymentMethodLabel(orderDetail.paymentMethod)
              )
          .col-md-4
            .mb-3
              label.form-label(for="order-payment-status") Payment Status
              select.form-select(id="order-payment-status" name="paymentStatus")
                option(
                  value="unpaid"
                  selected=(orderDetail.paymentStatus == "unpaid")
                ) Unpaid
                option(
                  value="paid"
                  selected=(orderDetail.paymentStatus == "paid")
                ) Paid
                option(
                  value="refunded"
                  selected=(orderDetail.paymentStatus == "refunded")
                ) Refunded
          .col-md-4
            .mb-3
              label.form-label(for="order-shipping-partner") Shipping Partner
              input.form-control(id="order-shipping-partner" 
                disabled
                value=orderDetail.shipping ? orderDetail.shipping.carrierName : ''
              )
        .row
          .col-md-3
            .mb-3
              label.form-label(for="order-subtotal") Subtotal
              input.form-control(id="order-subtotal" disabled value=formatPrice((orderDetail.subTotal || 0)))
          .col-md-3
            .mb-3
              label.form-label(for="order-coupon-code") Coupon Code
              input.form-control(id="order-coupon-code" disabled value=orderDetail.coupon || '-')
          .col-md-3
            .mb-3
              label.form-label(for="order-discount") Discount
              input.form-control(id="order-discount" disabled value=formatPrice((orderDetail.discount || 0)))
          .col-md-3
            .mb-3
              label.form-label(for="order-shipping-fee") Shipping Fee
              input.form-control(id="order-shipping-fee" 
                disabled
                value=
                  orderDetail.shipping && orderDetail.shipping.fee
                    ? formatPrice(orderDetail.shipping.fee)
                    : formatPrice(0)
                )
        .row
          .col-md-3
            .mb-3
              label.form-label(for="order-points-used") Points Used
              input.form-control(id="order-points-used" disabled value=orderDetail.usedPoint)
          .col-md-3
            .mb-3
              label.form-label(for="order-points-discount") Points Discount
              input.form-control(id="order-points-discount" disabled value=formatPrice((orderDetail.pointDiscount || 0)))
          .col-md-3
            .mb-3
              label.form-label(for="order-points-earned") Points Earned
              input.form-control(id="order-points-earned" disabled value=(orderDetail.pointEarned || 0) + ' pts')
          .col-md-3
            .mb-3
              label.form-label(for="order-total-payment") Total Payment
              input.form-control.text-danger(id="order-total-payment" 
                disabled
                value=formatPrice((orderDetail.total || 0))
              )
        h5.mt-4 Order Status
        .row
          .col-md-6
            .mb-3
              label.form-label(for="order-status") Status
              select.form-select(id="order-status" name="orderStatus")
                option(value="pending" selected=(orderDetail.orderStatus=="pending")) Pending
                option(value="confirmed" selected=(orderDetail.orderStatus=="confirmed")) Confirmed
                option(value="shipping" selected=(orderDetail.orderStatus=="shipping")) Shipping
                option(value="completed" selected=(orderDetail.orderStatus=="completed")) Completed
                option(value="returned" selected=(orderDetail.orderStatus=="returned")) Returned
                option(value="cancelled" selected=(orderDetail.orderStatus=="cancelled")) Cancelled
          .col-md-6
            .mb-3
              label.form-label(for="order-note") Note
              textarea.form-control(id="order-note" name="note" rows="2")= orderDetail.note
        .mt-4
          button.btn.btn-primary(type="submit") Update Order
          a.btn.btn-danger.ms-2(href=`/${pathAdmin}/order/list`) Back
