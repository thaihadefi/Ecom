extends ../layouts/default.pug
include ../mixins/index.pug

block main
  .row
    .col-12
      .card
        .card-header
          .row.align-items-center
            .col
              h4.card-title #{pageTitle}
            .col-auto
              a.btn.btn-outline-danger.me-1(href=`/${pathAdmin}/product/trash`)
                i.fa-solid.fa-trash.me-1
                | Trash
              button.btn.btn-danger.me-1(
                button-soft-delete-many
                data-api=`/${pathAdmin}/api/products/trash`
                style="display:none"
              )
                i.fa-solid.fa-trash.me-1
                | Move to Trash
              if (FEATURES.RECOMMENDATIONS)
                button#recompute-recommendations-btn.btn.btn-outline-primary.me-1(
                  data-recompute-api=`/${pathAdmin}/api/recommendation-jobs`
                  data-status-api=`/${pathAdmin}/api/recommendation-jobs/latest`
                  title="Recompute item-based collaborative filtering recommendations from order history"
                )
                  i.fa-solid.fa-wand-magic-sparkles.me-1
                  span#recompute-recommendations-btn-label Recompute Recommendations
              a.btn.btn-primary(
                href=`/${pathAdmin}/product/create`
                )
                i.fa-solid.fa-plus.me-1
                | Create Product
        .card-body.pt-0
          .row
            .col-sm-6
              +form-search()
            .col-sm-3
              a.btn.w-100.btn-info(href=`/${pathAdmin}/api/products/csv`)
                i.fa-solid.fa-download.me-1
                | Export Excel
            .col-lg-4
              form.input-group.mb-3(
                id="formImportExcel"
                data-api=`/${pathAdmin}/api/products/csv`
              )
                input(
                  class="form-control"
                  type="file"
                  name="file"
                  id="file"
                  accept=".csv"
                  aria-label="CSV file to import"
                )
                button.btn.btn-secondary Import Excel
          .table-responsive
            table.table.table-striped.mb-0
              thead.table-light
                tr
                  th(scope="col")
                    input.form-check-input.checkbox-all(type="checkbox" aria-label="Select all rows")
                  th(scope="col") No.
                  th(scope="col") Avatar
                  th(scope="col") Product Name
                  th.text-nowrap(scope="col") Old Price
                  th.text-nowrap(scope="col") New Price
                  th(scope="col") Stock
                  th(scope="col") Variants Count
                  th(scope="col") Position
                  th(scope="col") Status
                  th(scope="col") Views
                  th.text-end(scope="col") Action
              tbody
                if !recordList || !recordList.length
                  +empty-state()
                else
                  each item, index in recordList
                    tr
                      td
                        input.form-check-input.checkbox-input(type="checkbox" aria-label="Select this row" value=item.id)
                      td #{pagination.skip + index + 1}
                      td
                        if(item.images && item.images.length > 0)
                          img(
                            src=`${domainCDN}${item.images[0]}`
                            class="rounded thumb-md me-1 d-inline"
                            alt=""
                            loading="lazy"
                          )
                      td #{item.name}
                      td
                        if(item.priceOld)
                          | #{formatPrice(item.priceOld)}
                      td
                        if(item.priceNew)
                          | #{formatPrice(item.priceNew)}
                      td #{item.stock}
                      td #{item.variants ? item.variants.length : 0}
                      td #{item.position}
                      td
                        if (item.status == "draft")
                          span(class="badge bg-dark") Draft
                        else if (item.status == "active")
                          span(class="badge bg-success") Active
                        else if (item.status == "inactive")
                          span(class="badge bg-danger") Inactive
                      td #{item.view}
                      td.text-end
                        a.tbl-action(
                          href=`/${pathAdmin}/product/edit/${item.id}`
                          title="Edit"
                          aria-label="Edit"
                        )
                          i.las.la-pen.text-secondary.fs-20
                        a.tbl-action(
                          href=`/${pathAdmin}/product/edit-seo/${item.id}`
                          title="Edit SEO"
                          aria-label="Edit SEO"
                        )
                          i.las.la-search.text-secondary.fs-20
                        a.tbl-action.danger(
                          href="javascript:;"
                          button-api
                          data-method="DELETE"
                          data-api=`/${pathAdmin}/api/products/${item.id}`
                          title="Move to trash"
                          aria-label="Move to trash"
                        )
                          i.las.la-trash-alt.text-secondary.fs-20
          +pagination()

block script
  script.
    (() => {
      const btn = document.getElementById("recompute-recommendations-btn");
      const label = document.getElementById("recompute-recommendations-btn-label");
      if (!btn) return;

      const recomputeApi = btn.getAttribute("data-recompute-api");
      const statusApi = btn.getAttribute("data-status-api");
      let pollTimer = null;

      const setRunning = (running) => {
        btn.disabled = running;
        label.textContent = running ? "Recomputing..." : "Recompute Recommendations";
      };

      const poll = () => {
        fetch(statusApi)
          .then((res) => res.json())
          .then((data) => {
            const status = data.status;
            if (status.status === "running") {
              pollTimer = setTimeout(poll, 2000);
              return;
            }
            setRunning(false);
            if (status.lastError) {
              notyf.error("Recompute failed: " + status.lastError);
            } else if (status.lastResult) {
              const r = status.lastResult;
              drawNotify("success", `Recomputed recommendations for ${r.productsUpdated} products (scanned ${r.ordersScanned} orders).`);
            }
          })
          .catch(() => {
            setRunning(false);
          });
      };

      btn.addEventListener("click", () => {
        setRunning(true);
        fetch(recomputeApi, { method: "POST" })
          .then((res) => res.json())
          .then(() => {
            clearTimeout(pollTimer);
            poll();
          })
          .catch(() => {
            setRunning(false);
            notyf.error("Failed to start recompute.");
          });
      });
    })();
