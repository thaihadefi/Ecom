extends ../layouts/default.pug
include ../mixins/index.pug

block main
  .row
    .col-12
      .card
        .card-header
          .row.align-items-center
            .col
              h4.card-title #{pageTitle}
            // end col
            .col-auto
              a.btn.btn-outline-danger.me-1(href=`/${pathAdmin}/product/trash`)
                i.fa-solid.fa-trash.me-1
                | Trash
              button.btn.btn-danger.me-1(
                button-soft-delete-many
                data-api=`/${pathAdmin}/product/delete-many`
                style="display:none"
              )
                i.fa-solid.fa-trash.me-1
                | Move to Trash
              a.btn.btn-primary(
                href=`/${pathAdmin}/product/create`
                )
                i.fa-solid.fa-plus.me-1
                | Create Product
                // end col
            // end col
          // end row
        // end card-header
        .card-body.pt-0
          .row
            .col-sm-6
              +form-search()
            .col-sm-3
              a.btn.w-100.btn-info(href=`/${pathAdmin}/product/export/csv`)
                i.fa-solid.fa-download.me-1
                | Export Excel
            .col-lg-4
              form.input-group.mb-3(
                id="formImportExcel"
                data-api=`/${pathAdmin}/product/import/csv`
              )
                input(
                  class="form-control"
                  type="file"
                  name="file"
                  id="file"
                  accept=".csv"
                )
                button.btn.btn-secondary Import Excel
          .table-responsive
            table.table.table-striped.mb-0
              thead.table-light
                tr
                  th(scope="col")
                    input.form-check-input.checkbox-all(type="checkbox")
                  th(scope="col") No.
                  th(scope="col") Avatar
                  th(scope="col") Product Name
                  th(scope="col") Old Price (VND)
                  th(scope="col") New Price (VND)
                  th(scope="col") Stock
                  th(scope="col") Variants Count
                  th(scope="col") Position
                  th(scope="col") Status
                  th(scope="col") Views
                  th.text-end(scope="col") Action
              tbody
                if !recordList || !recordList.length
                  +empty-state()
                else
                  each item, index in recordList
                    tr
                      td
                        input.form-check-input.checkbox-input(type="checkbox" value=item.id)
                      td #{pagination.skip + index + 1}
                      td
                        if(item.images && item.images.length > 0)
                          img(
                            src=`${domainCDN}${item.images[0]}`
                            class="rounded thumb-md me-1 d-inline"
                            alt=""
                            loading="lazy"
                          )
                      td #{item.name}
                      td
                        if(item.priceOld)
                          | #{item.priceOld.toLocaleString("vi-VN")}
                      td
                        if(item.priceNew)
                          | #{item.priceNew.toLocaleString("vi-VN")}
                      td #{item.stock}
                      td #{item.variants ? item.variants.length : 0}
                      td #{item.position}
                      td
                        if (item.status == "draft")
                          span(class="badge bg-dark") Draft
                        else if (item.status == "active")
                          span(class="badge bg-success") Active
                        else if (item.status == "inactive")
                          span(class="badge bg-danger") Inactive
                      td #{item.view}
                      td.text-end
                        a.tbl-action(
                          href=`/${pathAdmin}/product/edit/${item.id}`
                          title="Edit"
                          aria-label="Edit"
                        )
                          i.las.la-pen.text-secondary.fs-20
                        a.tbl-action(
                          href=`/${pathAdmin}/product/edit-seo/${item.id}`
                          title="Edit SEO"
                          aria-label="Edit SEO"
                        )
                          i.las.la-search.text-secondary.fs-20
                        a.tbl-action.danger(
                          href="javascript:;"
                          button-api
                          data-method="PATCH"
                          data-api=`/${pathAdmin}/product/delete/${item.id}`
                          title="Move to trash"
                          aria-label="Move to trash"
                        )
                          i.las.la-trash-alt.text-secondary.fs-20
          +pagination()
    // end col
