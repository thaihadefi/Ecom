extends ../layouts/default.pug

block main
  if permissions.includes('dashboard')
    .row.mb-3
      .col-12
        .card
          .card-body.py-2
            form#formDateFilterOrder.d-flex.align-items-center.flex-wrap.gap-2(data-date-filter data-chart="order")
              label.mb-0.text-muted.small.me-1 From
              input.form-control.form-control-sm(
                type="date"
                name="from"
                style="width:150px"
              )
              label.mb-0.text-muted.small.mx-1 To
              input.form-control.form-control-sm(
                type="date"
                name="to"
                style="width:150px"
              )
              button.btn.btn-primary.btn-sm(type="submit") Filter
              button#btnOrderReset.btn.btn-outline-secondary.btn-sm(type="button" style="display:none") Reset

    #orderCustomSection(style="display:none")
      .row.justify-content-center
        .col-md-6.col-lg-4
          .card
            .card-header
              h4.card-title#orderCustomTitle Custom Range Order Status
            .card-body.pt-0
              canvas#orderStatusCustom

    #orderDefaultSection
      .row
        .col-md-12.col-lg-4
          .card
            .card-header
              .row.align-items-center
                .col
                  h4.card-title Order Status Ratio by Day
            .card-body.pt-0
              canvas#orderStatusToday
        .col-md-12.col-lg-4
          .card
            .card-header
              .row.align-items-center
                .col
                  h4.card-title Order Status Ratio by Month
            .card-body.pt-0
              canvas#orderStatusMonth
        .col-md-12.col-lg-4
          .card
            .card-header
              .row.align-items-center
                .col
                  h4.card-title Order Status Ratio by Year
            .card-body.pt-0
              canvas#orderStatusYear

block script
  script(src="https://cdn.jsdelivr.net/npm/chart.js")
  script.
    const pieToday = !{JSON.stringify(pieToday)};
    const pieThisMonth = !{JSON.stringify(pieThisMonth)};
    const pieThisYear = !{JSON.stringify(pieThisYear)};
  script(src="/admin/assets/js/my-chart.js")
