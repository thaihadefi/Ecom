extends ../layouts/default.pug
include ../mixins/index.pug

block main
  .row
    .col-12
      .card
        .card-header
          .row.align-items-center
            .col
              h4.card-title #{pageTitle}
            .col-auto
              a.btn.btn-outline-danger.me-1(href=`/${pathAdmin}/order/trash`)
                i.fa-solid.fa-trash.me-1
                | Trash
              button.btn.btn-danger.me-1(
                button-soft-delete-many
                data-api=`/${pathAdmin}/order/delete-many`
                style="display:none"
              )
                i.fa-solid.fa-trash.me-1
                | Move to Trash
        .card-body.pt-0
          .row
            .col-sm-6.mb-2
              +form-search()
            .col-lg-2.mb-2
              a.btn.w-100.btn-info(href=`/${pathAdmin}/order/export/csv`)
                i.fa-solid.fa-download.me-1
                | Export Excel
          .table-responsive
            table.table.table-striped.mb-0
              thead.table-light
                tr
                  th(scope="col")
                    input.form-check-input.checkbox-all(type="checkbox")
                  th(scope="col") No.
                  th(scope="col") Order Code
                  th(scope="col") Customer
                  th(scope="col") Total
                  th(scope="col") Payment
                  th(scope="col") Payment Status
                  th(scope="col") Order Status
                  th(scope="col") Date Created
                  th.text-end(scope="col") Action
              tbody
                if !recordList || !recordList.length
                  +empty-state()
                else
                  each item, index in recordList
                    tr
                      td
                        input.form-check-input.checkbox-input(type="checkbox" value=item.id)
                      td #{pagination.skip + index + 1}
                      td
                        b #{item.code}
                      td
                        div #{item.fullName}
                        small.text-muted #{item.phone}
                      td
                        b.text-danger #{(item.total || 0).toLocaleString('vi-VN')} VND
                      td
                        case item.paymentMethod
                          when "money"
                            span.badge.bg-secondary Cash
                          when "vnpay"
                            span.badge.bg-danger VNPay
                          when "zalopay"
                            span.badge.bg-primary ZaloPay
                      td
                        case item.paymentStatus
                          when "unpaid"
                            span.badge.bg-warning Unpaid
                          when "paid"
                            span.badge.bg-success Paid
                          when "refunded"
                            span.badge.bg-info Refunded
                      td
                        case item.orderStatus
                          when "pending"
                            span.badge.bg-secondary Pending
                          when "confirmed"
                            span.badge.bg-primary Confirmed
                          when "shipping"
                            span.badge.bg-info Shipping
                          when "completed"
                            span.badge.bg-success Completed
                          when "cancelled"
                            span.badge.bg-danger Cancelled
                          when "returned"
                            span.badge.bg-dark Returned
                      td
                        | #{item.createdAt ? item.createdAt.toLocaleString('vi-VN') : ''}
                      td.text-end
                        a.tbl-action(
                          href=`/${pathAdmin}/order/edit/${item.id}`
                          title="Edit order"
                          aria-label="Edit order"
                        )
                          i.las.la-pen.text-secondary.fs-20
                        a.tbl-action.danger(
                          href="javascript:;"
                          button-api
                          data-method="PATCH"
                          data-api=`/${pathAdmin}/order/delete/${item.id}`
                          title="Move to trash"
                          aria-label="Move to trash"
                        )
                          i.las.la-trash-alt.text-secondary.fs-20
          +pagination()
