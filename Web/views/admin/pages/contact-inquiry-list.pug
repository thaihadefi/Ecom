extends ../layouts/default.pug
include ../mixins/index.pug

block main
  .row
    .col-12
      .card
        .card-header
          .row.align-items-center
            .col
              h4.card-title #{pageTitle}
            .col-auto
              a.btn.btn-outline-danger.me-1(href=`/${pathAdmin}/contact-inquiry/trash`)
                i.fa-solid.fa-trash.me-1
                | Trash
              button.btn.btn-danger.me-1(
                button-soft-delete-many
                data-api=`/${pathAdmin}/contact-inquiry/delete-many`
                style="display:none"
              )
                i.fa-solid.fa-trash.me-1
                | Move to Trash
        .card-body.pt-0
          .row
            .col-lg-6
              +form-search()
          .table-responsive
            table.table.table-striped.mb-0
              thead.table-light
                tr
                  th(scope="col")
                    input.form-check-input.checkbox-all(type="checkbox")
                  th(scope="col") No.
                  th(scope="col") Contact Info
                  th(scope="col") Subject
                  th(scope="col") Message
                  th(scope="col") Status
                  th(scope="col") Date Created
                  th.text-end(scope="col") Action
              tbody
                if !recordList || !recordList.length
                  +empty-state()
                else
                  each item, index in recordList
                    tr
                      td
                        input.form-check-input.checkbox-input(type="checkbox" value=item.id)
                      td #{pagination.skip + index + 1}
                      td
                        div
                          strong #{item.name}
                        div.text-muted.small #{item.email}
                      td #{item.subject || '(No Subject)'}
                      td(style="max-width: 300px; white-space: normal; word-break: break-all;") #{item.message}
                      td
                        if (item.read)
                          span.badge.bg-success Read
                        else
                          span.badge.bg-warning Unread
                      td #{item.createdAt ? item.createdAt.toLocaleString("vi-VN") : ''}
                      td.text-end
                        if (!item.read)
                          a.tbl-action(
                            href="javascript:;"
                            button-api
                            data-method="PATCH"
                            data-api=`/${pathAdmin}/contact-inquiry/change-status/${item.id}/read`
                            title="Mark as Read"
                            aria-label="Mark as Read"
                          )
                            i.las.la-envelope-open.text-secondary.fs-20
                        else
                          a.tbl-action.warning(
                            href="javascript:;"
                            button-api
                            data-method="PATCH"
                            data-api=`/${pathAdmin}/contact-inquiry/change-status/${item.id}/unread`
                            title="Mark as Unread"
                            aria-label="Mark as Unread"
                          )
                            i.las.la-envelope.text-secondary.fs-20
                        a.tbl-action.danger(
                          href="javascript:;"
                          button-api
                          data-method="PATCH"
                          data-api=`/${pathAdmin}/contact-inquiry/delete/${item.id}`
                          title="Move to trash"
                          aria-label="Move to trash"
                        )
                          i.las.la-trash-alt.text-secondary.fs-20
          +pagination()
