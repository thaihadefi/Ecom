extends ../layouts/default.pug
include ../mixins/index.pug

block main
  .row
    .col-12
      .card
        .card-header
          .row.align-items-center
            .col
              h4.card-title #{pageTitle}
            .col-auto
              a.btn.btn-outline-danger.me-1(href=`/${pathAdmin}/account-admin/trash`)
                i.fa-solid.fa-trash.me-1
                | Trash
              button.btn.btn-danger.me-1(
                button-soft-delete-many
                data-api=`/${pathAdmin}/account-admin/delete-many`
                style="display:none"
              )
                i.fa-solid.fa-trash.me-1
                | Move to Trash
              a.btn.btn-primary(
                href=`/${pathAdmin}/account-admin/create`
                )
                i.fa-solid.fa-plus.me-1
                | Create Account
        .card-body.pt-0
          .row
            .col-lg-6
              +form-search()
          .table-responsive
            table.table.table-striped.mb-0
              thead.table-light
                tr
                  th(scope="col")
                    input.form-check-input.checkbox-all(type="checkbox")
                  th(scope="col") No.
                  th(scope="col") Avatar
                  th(scope="col") Full Name
                  th(scope="col") Email
                  th(scope="col") Permissions
                  th(scope="col") Status
                  th.text-end(scope="col") Action
              tbody
                if !recordList || !recordList.length
                  +empty-state()
                else
                  each item, index in recordList
                    tr
                      td
                        input.form-check-input.checkbox-input(type="checkbox" value=item.id)
                      td #{pagination.skip + index + 1}
                      td
                        if item.avatar
                          img(
                            src=`${domainCDN}${item.avatar}`
                            class="rounded thumb-md me-1 d-inline"
                            alt=""
                            loading="lazy"
                          )
                        else
                          - const _ap = (item.fullName||'A').trim().split(/\s+/)
                          - const _ai = (_ap[0][0]||'').toUpperCase() + (_ap.length>1?_ap[_ap.length-1][0]||'':_ap[0][1]||'').toUpperCase()
                          span.avatar-initials.thumb-md.rounded-circle= _ai
                      td #{item.fullName}
                      td #{item.email}
                      td(style="max-width: 200px;")
                        each roleName in item.rolesName
                          span(class="badge bg-dark me-1") #{roleName}
                      td
                        if (item.status == "initial")
                          span(class="badge bg-warning") Initial
                        else if (item.status == "active")
                          span(class="badge bg-success") Active
                        else if (item.status == "inactive")
                          span(class="badge bg-danger") Inactive
                      td.text-end
                        a.tbl-action(
                          href=`/${pathAdmin}/account-admin/edit/${item.id}`
                          title="Edit account"
                          aria-label="Edit account"
                        )
                          i.las.la-pen.text-secondary.fs-20
                        a.tbl-action(
                          href=`/${pathAdmin}/account-admin/change-password/${item.id}`
                          title="Change password"
                          aria-label="Change password"
                        )
                          i.las.la-key.text-secondary.fs-20
                        a.tbl-action.danger(
                          href="javascript:;"
                          button-api
                          data-method="PATCH"
                          data-api=`/${pathAdmin}/account-admin/delete/${item.id}`
                          title="Move to trash"
                          aria-label="Move to trash"
                        )
                          i.las.la-trash-alt.text-secondary.fs-20
          +pagination()
