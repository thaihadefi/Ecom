extends ../layouts/default.pug
include ../mixins/index.pug

block main
  .row
    .col-12
      .card
        .card-header
          +trash-header(`/${pathAdmin}/product/list`)
        .card-body.pt-0
          +trash-buttons(`/${pathAdmin}/api/products`)
          .table-responsive
            table.table.table-striped.mb-0
              thead.table-light
                tr
                  th(scope="col")
                    input.checkbox-all(type="checkbox" aria-label="Select all rows")
                  th(scope="col") No.
                  th(scope="col") Avatar
                  th(scope="col") Product Name
                  th(scope="col") Deleted At
                  th.text-end(scope="col") Action
              tbody
                if !recordList || !recordList.length
                  +empty-state("Trash is empty")
                else
                  each item, index in recordList
                    tr
                      td
                        input.checkbox-input(type="checkbox" aria-label="Select this row" value=item.id)
                      td #{index + 1}
                      td
                        if item.images && item.images.length > 0
                          img(src=`${domainCDN}${item.images[0]}` class="rounded thumb-md" alt="" loading="lazy")
                      td #{item.name}
                      td
                        small #{formatDateTime(item.deletedAt)}
                      td.text-end
                        +trash-action-buttons(
                          `/${pathAdmin}/api/products/${item.id}/restore`,
                          `/${pathAdmin}/api/products/${item.id}?permanent=true`
                        )
