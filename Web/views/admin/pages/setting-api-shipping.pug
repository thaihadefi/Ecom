extends ../layouts/default.pug

block main
  - const data = (record && record.data) || {}
  .card
    .card-header
      .row.align-items-center
        .col
          h4.card-title #{pageTitle}
    .card-body.pt-0
      form(id="settingApiShippingForm" data-setting-endpoint="shipping")
        .row
          .col-md-6
            .mb-3
              label.form-label(for="defaultItemWeight") Default weight per unit (grams)
              input.form-control(id="defaultItemWeight" name="defaultItemWeight" type="number" min="0" value=data.defaultItemWeight placeholder=`${defaultItemWeight}`)
              .form-text Used for products without their own weight.
        hr
        h5 GoShip
        .row
          .col-md-12
            .mb-3
              label.form-label(for="goshipApiUrl") GoShip API URL
              input(id="goshipApiUrl" name="goshipApiUrl" class="form-control" placeholder="https://sandbox.goship.io/api/v2" value=data.goshipApiUrl || "")
          .col-md-12
            .mb-3
              label.form-label(for="tokenGoShip") Token GoShip
              textarea(id="tokenGoShip" name="tokenGoShip" class="form-control") #{data.tokenGoShip || ""}
        button.btn.btn-primary(type="submit") Update
