extends ../layouts/default.pug

block main
  .row
    .col-12
      .card
        .card-body.text-center.py-5
          h1.display-4 404
          h4.mb-3 Page not found
          p.text-muted.mb-4 The page you’re looking for doesn’t exist or has been moved.
          .d-flex.flex-wrap.gap-2.justify-content-center
            a.btn.btn-primary(href=`/${pathAdmin}/dashboard`) Back to Dashboard
            a.btn.btn-outline-secondary(href="javascript:history.back()") Back
