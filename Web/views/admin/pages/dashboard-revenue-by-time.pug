extends ../layouts/default.pug

block main
  if permissions.includes('dashboard')
    .row.mb-3
      .col-12
        .card
          .card-body.py-2
            form#formDateFilterRevenue.d-flex.align-items-center.flex-wrap.gap-2(data-date-filter data-chart="revenue")
              label.mb-0.text-muted.small.me-1 From
              input.form-control.form-control-sm(
                type="date"
                name="from"
                style="width:150px"
              )
              label.mb-0.text-muted.small.mx-1 To
              input.form-control.form-control-sm(
                type="date"
                name="to"
                style="width:150px"
              )
              button.btn.btn-primary.btn-sm(type="submit") Filter
              button#btnRevenueReset.btn.btn-outline-secondary.btn-sm(type="button" style="display:none") Reset

    #revenueCustomSection(style="display:none")
      .row
        .col-12
          .card
            .card-header
              h4.card-title#revenueCustomTitle Custom Range Revenue
            .card-body.pt-0
              canvas#revenueChartCustom

    #revenueDefaultSection
      .row
        .col-md-12.col-lg-12
          .card
            .card-header
              .row.align-items-center
                .col
                  h4.card-title Revenue Chart by Hour
            .card-body.pt-0
              canvas#revenueChartHour

      .row
        .col-md-12.col-lg-12
          .card
            .card-header
              .row.align-items-center
                .col
                  h4.card-title Revenue Chart by Day
            .card-body.pt-0
              canvas#revenueChartDay

      .row
        .col-md-12.col-lg-12
          .card
            .card-header
              .row.align-items-center
                .col
                  h4.card-title Revenue Chart by Month
            .card-body.pt-0
              canvas#revenueChartMonth

block script
  script(src="https://cdn.jsdelivr.net/npm/chart.js@4.5.1" integrity="sha384-jb8JQMbMoBUzgWatfe6COACi2ljcDdZQ2OxczGA3bGNeWe+6DChMTBJemed7ZnvJ" crossorigin="anonymous")
  script.
    const labelsHour = !{safeJson(labelsHour)};
    const todayData = !{safeJson(todayData)};
    const yesterdayData = !{safeJson(yesterdayData)};
    const labelsDay = !{safeJson(labelsDay)};
    const thisMonthData = !{safeJson(thisMonthData)};
    const lastMonthData = !{safeJson(lastMonthData)};
    const labelsMonth = !{safeJson(labelsMonth)};
    const thisYearData = !{safeJson(thisYearData)};
    const lastYearData = !{safeJson(lastYearData)};
  script(src="/admin/assets/js/my-chart.js")
