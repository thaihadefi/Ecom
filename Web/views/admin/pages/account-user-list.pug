extends ../layouts/default.pug
include ../mixins/index.pug

block main
  .row
    .col-12
      .card
        .card-header
          .row.align-items-center
            .col
              h4.card-title #{pageTitle}
            .col-auto
              a.btn.btn-outline-danger.me-1(href=`/${pathAdmin}/account-user/trash`)
                i.fa-solid.fa-trash.me-1
                | Trash
              button.btn.btn-danger.me-1(
                button-soft-delete-many
                data-api=`/${pathAdmin}/account-user/delete-many`
                style="display:none"
              )
                i.fa-solid.fa-trash.me-1
                | Move to Trash
              a.btn.btn-primary(
                href=`/${pathAdmin}/account-user/create`
                )
                i.fa-solid.fa-plus.me-1
                | Create Account
        .card-body.pt-0
          .row
            .col-lg-6
              +form-search()
          .table-responsive
            table.table.table-striped.mb-0
              thead.table-light
                tr
                  th(scope="col")
                    input.form-check-input.checkbox-all(type="checkbox")
                  th(scope="col") No.
                  th(scope="col") Avatar
                  th(scope="col") Full Name
                  th(scope="col") Email
                  th(scope="col") Phone Number
                  th(scope="col") Account Type
                  th(scope="col") Status
                  th.text-end(scope="col") Action
              tbody
                if !recordList || !recordList.length
                  +empty-state()
                else
                  each item, index in recordList
                    tr
                      td
                        input.form-check-input.checkbox-input(type="checkbox" value=item.id)
                      td #{pagination.skip + index + 1}
                      td
                        if item.avatar && !item.avatar.startsWith('http')
                          img(src=`${domainCDN}/${item.avatar}` class="rounded thumb-md me-1 d-inline" alt="" loading="lazy")
                        else
                          - var _words = (item.fullName || 'U').trim().split(/\s+/)
                          - var _initials = (_words.length >= 2 ? _words[0][0] + _words[_words.length-1][0] : _words[0][0]).toUpperCase()
                          span.d-inline-flex.align-items-center.justify-content-center.rounded.me-1(
                            style="width:40px;height:40px;background:linear-gradient(135deg,#22c5ad,#7367f0);color:#fff;font-size:13px;font-weight:600;"
                          ) #{_initials}
                      td #{item.fullName}
                      td #{item.email}
                      td #{item.phone}
                      td
                        if (item.googleId)
                          span(class="badge bg-danger") Google
                        else if (item.facebookId)
                          span(class="badge bg-info") Facebook
                        else
                          span(class="badge bg-warning") System
                      td
                        if (item.status == "active")
                          span(class="badge bg-success") Active
                        else if (item.status == "inactive")
                          span(class="badge bg-danger") Inactive
                      td.text-end
                        a.tbl-action.danger(
                          href="javascript:;"
                          button-api
                          data-method="PATCH"
                          data-api=`/${pathAdmin}/account-user/delete/${item.id}`
                          title="Move to trash"
                          aria-label="Move to trash"
                        )
                          i.las.la-trash-alt.text-secondary.fs-20
          +pagination()
