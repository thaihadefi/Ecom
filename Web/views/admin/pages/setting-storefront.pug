extends ../layouts/default.pug

block main
  .card
    .card-header
      .row.align-items-center
        .col
          h4.card-title #{pageTitle}
    .card-body.pt-0
      form(id="settingStorefrontForm" data-setting-endpoint="storefront")
        h5 Theme
        .row
          .col-md-6
            .mb-3
              label.form-label(for="primaryColor") Primary color
              .input-group
                input.form-control.form-control-color(id="primaryColorPicker" type="color" aria-label="Pick the primary color" value=values.primaryColor style="max-width: 48px; padding: 4px; cursor: pointer;" oninput="document.getElementById('primaryColor').value = this.value")
                input.form-control(id="primaryColor" name="primaryColor" type="text" value=values.primaryColor placeholder="#0057B7" oninput="if(/^#[0-9A-Fa-f]{6}$/.test(this.value.trim())) document.getElementById('primaryColorPicker').value = this.value.trim()")
          .col-md-6
            .mb-3
              label.form-label(for="secondaryColor") Secondary color
              .input-group
                input.form-control.form-control-color(id="secondaryColorPicker" type="color" aria-label="Pick the secondary color" value=values.secondaryColor style="max-width: 48px; padding: 4px; cursor: pointer;" oninput="document.getElementById('secondaryColor').value = this.value")
                input.form-control(id="secondaryColor" name="secondaryColor" type="text" value=values.secondaryColor placeholder="#FFD700" oninput="if(/^#[0-9A-Fa-f]{6}$/.test(this.value.trim())) document.getElementById('secondaryColorPicker').value = this.value.trim()")
          .col-md-6
            .mb-3
              label.form-label(for="headingFont") Heading font (Google Fonts)
              input.form-control(id="headingFont" name="headingFont" value=values.headingFont placeholder="Keep the theme font")
          .col-md-6
            .mb-3
              label.form-label(for="bodyFont") Body font (Google Fonts)
              input.form-control(id="bodyFont" name="bodyFont" value=values.bodyFont placeholder="Keep the theme font")
          .col-md-6
            .mb-3
              label.form-label(for="logoDisplay") Header logo
              select.form-select(id="logoDisplay" name="logoDisplay")
                option(value="logo" selected=values.logoDisplay === "logo") Logo only
                option(value="logo-name" selected=values.logoDisplay === "logo-name") Logo and store name
              .form-text Choose "Logo and store name" when the logo image does not spell the name (Settings > General).
        hr
        h5 Currency and locale
        p.text-muted.small Prices are entered, stored and charged in the store currency. Choose it when setting up the store: changing it later does not convert existing prices. Payment methods that cannot charge in it are hidden from checkout (VNPay and ZaloPay only charge in VND).
        .row
          .col-md-3
            .mb-3
              label.form-label(for="currency") Store currency (ISO code)
              input.form-control(id="currency" name="currency" value=values.currency maxlength="3" placeholder="VND")
          .col-md-3
            .mb-3
              label.form-label(for="locale") Number and date format
              input.form-control(id="locale" name="locale" value=values.locale placeholder="vi-VN")
          .col-md-3
            .mb-3
              label.form-label(for="timezone") Time zone
              select.form-select(id="timezone" name="timezone")
                each zone in timeZones
                  option(value=zone selected=zone === selectedTimeZone) #{zone}
          .col-md-3
            .mb-3
              label.form-label(for="language") Page language (html lang)
              input.form-control(id="language" name="language" value=values.language placeholder="en")
          .col-md-12
            .mb-3
              label.form-label(for="displayCurrencies") Display currencies
              input.form-control(id="displayCurrencies" name="displayCurrencies" value=values.displayCurrencies.join(", ") placeholder="USD, EUR")
              .form-text Shoppers can view prices in these currencies with live exchange rates, for reference only. Leave only the store currency to hide the switcher.
        hr
        h5 Loyalty points
        .row
          .col-md-6
            .mb-3
              label.form-label(for="moneyPerPoint") Order value that earns 1 point
              input.form-control(id="moneyPerPoint" name="moneyPerPoint" type="number" min="0" step="any" value=values.moneyPerPoint)
          .col-md-6
            .mb-3
              label.form-label(for="pointValue") Discount 1 point is worth
              input.form-control(id="pointValue" name="pointValue" type="number" min="0" step="any" value=values.pointValue)
        hr
        h5 Product page promises
        .mb-3
          label.form-label(for="productPromises") Promises shown beside every product
          textarea.form-control(id="productPromises" name="productPromises" rows="4" placeholder="Returns within 30 days of delivery | /return-policy")= values.productPromises
          .form-text One promise per line. Add " | /page" to link it, for example to the Return Policy. Keep them in line with your policy pages; leave empty to hide the box. Cash on Delivery is added automatically when that payment method is on.
        button.btn.btn-primary(type="submit") Update
