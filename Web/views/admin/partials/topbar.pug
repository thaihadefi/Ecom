.topbar.d-print-none
  .container-xxl
    nav#topbar-custom.topbar-custom.d-flex.justify-content-between
      ul.topbar-item.list-unstyled.d-inline-flex.align-items-center.mb-0
        li
          button#togglemenu.nav-link.mobile-menu-btn.nav-icon
            i.iconoir-menu-scale
        li.mx-3.welcome-text
          if accountAdmin
            h3.mb-0.fw-bold.text-truncate Hello, #{accountAdmin.fullName}!
          else
            h3.mb-0.fw-bold.text-truncate Hello!
      ul.topbar-item.list-unstyled.d-inline-flex.align-items-center.mb-0
        if accountAdmin
          - const _ap = (accountAdmin.fullName||'A').trim().split(/\s+/)
          - const _ai = (_ap[0][0]||'').toUpperCase() + (_ap.length>1?_ap[_ap.length-1][0]||'':_ap[0][1]||'').toUpperCase()
          li.dropdown.topbar-item
            a.nav-link.dropdown-toggle.arrow-none.nav-icon(
              aria-expanded="false"
              aria-haspopup="false"
              role="button"
              href="#"
              data-bs-toggle="dropdown"
              )
              if accountAdmin.avatar
                img.thumb-lg.rounded-circle(alt="" src=`${accountAdmin.isSuperAdmin ? "" : domainCDN}${accountAdmin.avatar}`)
              else
                span.avatar-initials.thumb-lg.rounded-circle= _ai
            .dropdown-menu.dropdown-menu-end.py-0
              .d-flex.align-items-center.dropdown-item.py-2.bg-secondary-subtle
                .flex-shrink-0
                  if accountAdmin.avatar
                    img.thumb-md.rounded-circle(alt="" src=`${accountAdmin.isSuperAdmin ? "" : domainCDN}${accountAdmin.avatar}`)
                  else
                    span.avatar-initials.thumb-md.rounded-circle= _ai
                .flex-grow-1.ms-2.text-truncate.align-self-center
                  h6.my-0.fw-medium.text-dark.fs-13 #{accountAdmin.fullName}
              .dropdown-divider.mt-0
              small.text-muted.px-2.pb-1.d-block Account
              a.dropdown-item(href=`/${pathAdmin}/account-admin/edit/${accountAdmin.id}`)
                i.las.la-user.fs-18.me-1.align-text-bottom
                | Personal Information
              .dropdown-divider.mb-0
              a.dropdown-item.text-danger(href=`/${pathAdmin}/account/logout`)
                i.las.la-power-off.fs-18.me-1.align-text-bottom
                | Logout
