doctype html
html(
  data-bs-theme="light"
  data-startbar="light"
  dir="ltr"
  lang="en"
  )
  head
    script.
      const pathAdmin = "#{pathAdmin}";
      const domainCDN = "#{domainCDN}";
    meta(charset="utf-8")
    title #{pageTitle}
    meta(
      content="width=device-width, initial-scale=1, shrink-to-fit=no"
      name="viewport"
      )
    meta(
      name="description"
      content="Ecom - Enterprise Store Administration Panel"
      )
    meta(
      name="author"
      content="Ecom Platform"
      )
    meta(
      content="IE=edge"
      http-equiv="X-UA-Compatible"
      )
    link(
      href=`${settingGeneral && settingGeneral.favicon ? domainCDN + settingGeneral.favicon : '/images/favicon.ico'}`
      rel="shortcut icon"
      )
    link(rel="stylesheet", href="https://cdn.jsdelivr.net/npm/notyf@3/notyf.min.css")
    link(href="https://releases.transloadit.com/uppy/v4.18.2/uppy.min.css" rel="stylesheet")
    link(rel="stylesheet", href="https://unpkg.com/mobius1-selectr@latest/dist/selectr.min.css")
    link(href="https://cdn.jsdelivr.net/npm/jsoneditor@10.4.2/dist/jsoneditor.min.css" rel="stylesheet")
    link(
      type="text/css"
      rel="stylesheet"
      href="/admin/assets/libs/vanillajs-datepicker/css/datepicker.min.css"
      )
    link(
      type="text/css"
      rel="stylesheet"
      href="/admin/assets/css/bootstrap.min.css"
      )
    link(
      type="text/css"
      rel="stylesheet"
      href="/admin/assets/css/icons.min.css"
      )
    link(
      type="text/css"
      rel="stylesheet"
      href="/admin/assets/css/app.min.css"
      )
    link(
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css"
      )
    link(
      type="text/css"
      rel="stylesheet"
      href="/admin/assets/css/main.css"
      )
  body
    include ../partials/topbar.pug
    include ../partials/startbar.pug
    .page-wrapper
      main.page-content(role="main" id="main-content")
        .container-xxl
          block main
        include ../partials/footer.pug

    include ../partials/modal-file-manager.pug
    include ../partials/modal-confirm.pug

    script(src="https://unpkg.com/just-validate@latest/dist/just-validate.production.min.js")
    script(src="https://cdn.jsdelivr.net/npm/notyf@3/notyf.min.js")
    script(src=`https://cdn.tiny.cloud/1/${tinymceApiKey}/tinymce/8/tinymce.min.js` referrerpolicy="origin" crossorigin="anonymous")
    script(src="/admin/assets/libs/bootstrap/js/bootstrap.bundle.min.js")
    script(src="/admin/assets/libs/simplebar/simplebar.min.js")
    script(src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.6/Sortable.min.js")
    script(src="https://unpkg.com/mobius1-selectr@latest/dist/selectr.min.js")
    script(src="https://cdn.jsdelivr.net/npm/jsoneditor@10.4.2/dist/jsoneditor.min.js")
    block script
    script(src="/admin/assets/libs/vanillajs-datepicker/js/datepicker-full.min.js")
    script(src="/admin/assets/js/app.js")
    script(src="/admin/assets/js/main.js")
    script(src="/admin/assets/js/uppy.js" type="module")
    script(src="/socket.io/socket.io.js")
    script(src="/admin/assets/js/chat.js")
